---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FinalCTA from '../components/global/FinalCTA.astro';
import { Image } from 'astro:assets';

import locationsData from '../data/locations.json';
import portfolioData from '../data/portfolio.json';
import site from '../data/site.json';

// `lat` / `lng` are optional and not present on any location yet. Declaring
// them here keeps the map plumbing typed before the coordinates land.
type LocationRecord = (typeof locationsData)[number] & { lat?: number; lng?: number };
const allLocations = locationsData as LocationRecord[];

const locationImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/locations/*.jpg',
  { eager: true }
);

const galleryImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/locations-gallery/**/*.{jpg,jpeg,JPG,JPEG}',
  { eager: true }
);

const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio/**/*.jpg',
  { eager: true }
);

// A location counts as "shot here" if either a gallery folder exists for its
// slug, or any portfolio entry's free-form `location` string contains the
// slug words (loose match handles "Aera Toronto, Downtown" vs "aera-toronto").
const portfolioLocStrings = portfolioData.map((p) => (p.location ?? '').toLowerCase());
const galleryPathSet = new Set(Object.keys(galleryImages));

const shotHereFor = (slug: string, name: string): boolean => {
  for (const path of galleryPathSet) {
    if (path.includes(`/locations-gallery/${slug}/`)) return true;
  }
  const slugWords = slug.replace(/-/g, ' ');
  const lname = name.toLowerCase();
  return portfolioLocStrings.some((loc) => loc.includes(slugWords) || loc.includes(lname));
};

const isPortrait = (img: ImageMetadata): boolean => img.height > img.width;

// For "shot here" entries, prefer a real session frame over the stock location
// image. Priority: locations-gallery/<slug>/ first frame → matching portfolio
// entry first frame → stock image fallback. Within each source the first
// PORTRAIT frame wins, so the 4:5 card crop never zooms into a landscape.
// The fallback may be null (no stock file on disk), in which case a location
// with session frames still earns a card and one without becomes a text row.
const previewForShotLocation = (
  slug: string,
  name: string,
  fallback: ImageMetadata | null
): ImageMetadata | null => {
  const galleryKeys = Object.keys(galleryImages)
    .filter((p) => p.includes(`/locations-gallery/${slug}/`))
    .sort();
  if (galleryKeys.length > 0) {
    const portraitKey = galleryKeys.find((k) => isPortrait(galleryImages[k].default));
    return galleryImages[portraitKey ?? galleryKeys[0]].default;
  }

  const slugWords = slug.replace(/-/g, ' ');
  const lname = name.toLowerCase();
  const match = portfolioData.find((p) => {
    const loc = (p.location ?? '').toLowerCase();
    return loc.includes(slugWords) || loc.includes(lname);
  });
  if (match && Array.isArray(match.images) && match.images.length > 0) {
    const frames = match.images
      .map((file) => portfolioImages[`/src/assets/images/portfolio/${match.slug}/${file}`]?.default)
      .filter((img): img is ImageMetadata => Boolean(img));
    if (frames.length > 0) return frames.find(isPortrait) ?? frames[0];
  }

  return fallback;
};

// One quiet at-a-glance permit read per entry. Any value outside these four
// renders no line at all rather than a guess.
const permitLines: Record<string, string> = {
  No: 'No permit needed',
  Sometimes: 'Permit sometimes needed',
  Yes: 'Permit required',
  'Venue booking': 'Book the venue first',
};

// Text rows get one short clause, cut at the first period or comma.
const shortDescriptor = (value: string): string => (value.split(/[.,]/)[0] ?? '').trim();

const sorted = [...allLocations].sort((a, b) => a.name.localeCompare(b.name));

// Every location renders. Ones with a resolvable photo become cards; the rest
// become compact text rows rather than being dropped from the guide.
const entries = sorted.map((loc) => {
  const stockImg = locationImages[`/src/assets/images/locations/${loc.image}`]?.default ?? null;
  const shotHere = shotHereFor(loc.id, loc.name);
  const img = shotHere ? previewForShotLocation(loc.id, loc.name, stockImg) : stockImg;
  const permitLine = permitLines[loc.permitNeeded ?? ''] ?? null;
  const haystack = `${loc.name} ${loc.area} ${loc.vibe} ${loc.bestFor.join(' ')} ${loc.setting.join(' ')} ${loc.zone} ${loc.season.join(' ')} ${permitLine ?? ''}`.toLowerCase();
  const hasCoords = typeof loc.lat === 'number' && typeof loc.lng === 'number';
  return { ...loc, img, shotHere, permitLine, haystack, hasCoords };
});

// Sixteen city regions. Zone values are city names; a region with no
// locations renders no section and no jump link.
const areaGroups = [
  { id: 'downtown-toronto', title: 'Downtown Toronto', zones: ['Downtown'] },
  { id: 'north-york', title: 'North York', zones: ['North York'] },
  { id: 'east-york', title: 'East York', zones: ['East York'] },
  { id: 'scarborough', title: 'Scarborough', zones: ['Scarborough'] },
  { id: 'etobicoke', title: 'Etobicoke', zones: ['Etobicoke'] },
  { id: 'mississauga', title: 'Mississauga', zones: ['Mississauga'] },
  { id: 'brampton', title: 'Brampton', zones: ['Brampton'] },
  { id: 'caledon', title: 'Caledon', zones: ['Caledon'] },
  { id: 'vaughan', title: 'Vaughan', zones: ['Vaughan'] },
  { id: 'markham', title: 'Markham', zones: ['Markham'] },
  { id: 'richmond-hill', title: 'Richmond Hill', zones: ['Richmond Hill'] },
  { id: 'oakville-halton', title: 'Oakville & Halton', zones: ['Oakville', 'Halton'] },
  { id: 'burlington', title: 'Burlington', zones: ['Burlington'] },
  { id: 'hamilton-dundas', title: 'Hamilton & Dundas', zones: ['Hamilton'] },
  { id: 'niagara', title: 'Niagara', zones: ['Niagara'] },
  { id: 'oshawa-durham', title: 'Oshawa & Durham', zones: ['Oshawa', 'Durham'] },
];

const groups = areaGroups
  .map((group) => {
    const inGroup = entries.filter((e) => group.zones.includes(e.zone));
    const withPhoto = inGroup.filter((e) => e.img);
    const pins = inGroup
      .filter((e) => e.hasCoords)
      .map((e) => ({ name: e.name, href: `/location-guide/${e.id}/`, lat: e.lat, lng: e.lng }));
    return {
      ...group,
      cards: [...withPhoto.filter((e) => e.shotHere), ...withPhoto.filter((e) => !e.shotHere)],
      rows: inGroup.filter((e) => !e.img),
      count: inGroup.length,
      pins,
    };
  })
  .filter((group) => group.count > 0);

const locationListSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Best Photography Locations in Toronto & the GTA',
    description: 'Curated photography locations across Toronto and the GTA by AD Photography, with parking, permits, and session tips.',
    url: `${site.url}/location-guide`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Best Photography Locations in Toronto',
    description: 'Curated photography locations in Toronto and the GTA by AD Photography',
    url: `${site.url}/location-guide`,
    numberOfItems: entries.length,
    itemListElement: entries.map((loc, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${site.url}/location-guide/${loc.id}`,
      item: {
        '@type': 'Place',
        name: loc.name,
        description: loc.vibe,
        url: `${site.url}/location-guide/${loc.id}`,
        address: {
          '@type': 'PostalAddress',
          addressLocality: loc.area,
          addressRegion: 'ON',
          addressCountry: 'CA',
        },
      },
    })),
  },
];
---

<BaseLayout
  title="Best Photography Locations in Toronto & the GTA"
  description="Curated Toronto and GTA photography locations for pre-wedding, engagement, and portrait sessions. Parking, permits, and best times for each."
  jsonLd={locationListSchema}
>
  <div class="container-editorial" style="padding-top: var(--spacing-block); padding-bottom: var(--spacing-block);">
    <div class="sr-only">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Location Guide', href: '/location-guide/' },
      ]} />
    </div>

    <header style="margin-bottom: var(--spacing-block);">
      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-6 items-end">
        <div class="md:col-span-5 reveal">
          <p class="text-label-md text-on-surface-muted eyebrow-rule mb-4">Location Guide</p>
          <h1 class="text-display-md reveal stagger-1">Toronto Location Guide</h1>
        </div>
        <div class="md:col-span-6 md:col-start-7 mt-6 md:mt-0 reveal stagger-2">
          <p class="text-body-lg text-on-surface-variant measure-wide">
            Every place I shoot across Toronto and the GTA, grouped by area. Each card shows the place, the feel of it, and what it works best for. Tap any location for the full rundown: parking, permits, walking, best seasons.
          </p>
        </div>
      </div>
    </header>

    <nav class="lg-jump reveal" aria-label="Browse by area">
      {groups.map((group) => (
        <a class="lg-jump-link text-label-md" href={`#${group.id}`}>
          {group.title}
          <span class="lg-jump-count">{group.count}</span>
        </a>
      ))}
    </nav>

    <form class="mosaic-search reveal" role="search" autocomplete="off" onsubmit="return false;">
      <label for="location-search" class="sr-only">Search locations</label>
      <svg class="mosaic-search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="7" />
        <path stroke-linecap="round" d="m20 20-3.5-3.5" />
      </svg>
      <input
        id="location-search"
        type="search"
        placeholder="Search by name, area, vibe, or season"
        class="mosaic-search-input"
        data-search-input
      />
      <button type="button" class="mosaic-search-clear" aria-label="Clear search" data-search-clear hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6l-12 12" />
        </svg>
      </button>
    </form>

    <p class="mosaic-search-count" aria-live="polite">
      Showing <span data-search-count>{entries.length}</span> of {entries.length} locations
    </p>

    {groups.map((group, groupIndex) => (
      <section id={group.id} class="lg-section reveal">
        <header class="lg-section-header">
          <h2 class="lg-section-title">{group.title}</h2>
          <p class="lg-section-count text-label-sm text-on-surface-muted">
            {group.count} {group.count === 1 ? 'location' : 'locations'}
          </p>
          {group.pins.length > 0 && (
            <button
              type="button"
              class="lg-map-toggle text-label-md"
              aria-expanded="false"
              aria-controls={`${group.id}-map`}
              data-map-toggle
              data-map-target={`${group.id}-map`}
              data-map-pins={JSON.stringify(group.pins)}
            >View map</button>
          )}
        </header>

        {group.pins.length > 0 && (
          <div class="lg-map" id={`${group.id}-map`} role="application" aria-label={`Map of ${group.title} locations`} hidden></div>
        )}

        {group.cards.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-10">
            {group.cards.map((loc, i) => (
              <a
                href={`/location-guide/${loc.id}/`}
                class="lg-card group block reveal"
                aria-label={`View details for ${loc.name}`}
                data-search-haystack={loc.haystack}
                style={`transition-delay: ${(i % 6) * 80 + 100}ms;`}
              >
                <div class="lg-card-media aspect-[4/5] overflow-hidden bg-surface-container">
                  <Image
                    src={loc.img!}
                    alt={`${loc.name}, pre-wedding and engagement photography location in ${loc.area}`}
                    widths={[400, 640, 960]}
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    class="w-full h-full object-cover cubic-ease group-hover:scale-[1.03]"
                    style="transition-duration: var(--duration-slow);"
                    loading={groupIndex === 0 && i < 3 ? 'eager' : 'lazy'}
                    fetchpriority={groupIndex === 0 && i === 0 ? 'high' : 'auto'}
                  />
                  {loc.shotHere && (
                    <span class="lg-session-label text-label-sm">From a session here</span>
                  )}
                </div>

                <div class="mt-4">
                  <h3 class="text-heading-md font-serif">{loc.name}</h3>
                  <p class="text-label-sm text-on-surface-muted mt-1">{loc.area}</p>
                  <p class="lg-vibe text-body-md text-on-surface-variant mt-3">{loc.vibeLine ?? loc.vibe}</p>
                  {loc.bestFor.length > 0 && (
                    <p class="text-label-sm text-on-surface-muted mt-3">{loc.bestFor.slice(0, 3).join(' · ')}</p>
                  )}
                  {loc.permitLine && (
                    <p class="lg-permit text-label-sm mt-2">{loc.permitLine}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}

        {group.rows.length > 0 && (
          <div class="lg-rows" data-row-block>
            <p class="lg-rows-heading text-label-sm text-on-surface-muted">More spots in {group.title}</p>
            <ul class="lg-row-list">
              {group.rows.map((loc) => {
                const descriptor = shortDescriptor(loc.vibeLine ?? loc.vibe);
                return (
                  <li class="lg-row" data-search-haystack={loc.haystack}>
                    <a class="lg-row-link" href={`/location-guide/${loc.id}/`}>
                      <span class="lg-row-name">{loc.name}</span>
                      {descriptor && (
                        <>
                          <span class="lg-row-sep" aria-hidden="true">·</span>
                          <span class="lg-row-note">{descriptor}</span>
                        </>
                      )}
                      {loc.permitLine && (
                        <>
                          <span class="lg-row-sep" aria-hidden="true">·</span>
                          <span class="lg-row-note">{loc.permitLine}</span>
                        </>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </section>
    ))}

    <p class="mosaic-no-results" data-search-empty hidden>
      No locations match that search. Try a city, a vibe, or a season.
    </p>

  </div>

  <FinalCTA
    eyebrow="Still deciding?"
    title="Not sure where to shoot?"
    body="Location guidance is included with every package. I'll help you find the perfect spot."
    useBookingLink={true}
    bookingLabel="Book a Consultation"
    background="surface-dim"
  />
</BaseLayout>

<script>
  // ── Client-side filter ──
  // Matches against name, area, vibe, tags, setting, zone, season and the
  // permit phrase (all lowercased into data-search-haystack server-side).
  // Cards and text rows are filtered by the same rule.
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const items = document.querySelectorAll<HTMLElement>('[data-search-haystack]');
  const countEl = document.querySelector<HTMLElement>('[data-search-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-search-empty]');
  const sections = document.querySelectorAll<HTMLElement>('.lg-section');

  const anyVisible = (scope: HTMLElement): boolean =>
    Array.from(scope.querySelectorAll<HTMLElement>('[data-search-haystack]')).some((el) => !el.hidden);

  function applyFilter() {
    if (!input) return;
    const q = input.value.trim().toLowerCase();
    let matches = 0;
    items.forEach((item) => {
      const haystack = item.dataset.searchHaystack || '';
      const show = !q || haystack.includes(q);
      item.hidden = !show;
      if (show) matches++;
    });
    sections.forEach((sec) => {
      // Drop the "More spots in X" sub-block when none of its rows survive,
      // then the whole region when neither cards nor rows survive.
      sec.querySelectorAll<HTMLElement>('[data-row-block]').forEach((block) => {
        block.hidden = !anyVisible(block);
      });
      sec.hidden = !anyVisible(sec);
    });
    if (countEl) countEl.textContent = String(matches);
    if (clearBtn) clearBtn.hidden = q.length === 0;
    if (emptyEl) emptyEl.hidden = matches > 0;
  }

  input?.addEventListener('input', applyFilter);
  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    input.focus();
    applyFilter();
  });

  // ── Per-region maps ──
  // Leaflet and its stylesheet are pulled in on the first map open only, so a
  // visitor who never taps "View map" downloads none of it. The CSS comes in
  // via ?inline and is injected at runtime: a plain dynamic CSS import would
  // be hoisted into the page stylesheet at build time and ship to everyone.
  type Pin = { name: string; href: string; lat: number; lng: number };

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let leafletPromise: Promise<any> | null = null;

  const escapeHtml = (value: string): string =>
    value.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  async function loadLeaflet(): Promise<any> {
    if (!leafletPromise) {
      leafletPromise = (async () => {
        const [mod, css] = await Promise.all([
          import('leaflet'),
          import('leaflet/dist/leaflet.css?inline'),
        ]);
        const style = document.createElement('style');
        style.textContent = `${css.default}
          .lg-pin{display:flex;align-items:center;justify-content:center;width:26px;height:26px;
            background:var(--color-on-surface,#1a1a18);color:var(--color-on-dark,#faf9f6);
            font-family:var(--font-sans);font-size:11px;font-weight:500;letter-spacing:0.04em;border-radius:0;}
          .leaflet-container{background:var(--color-surface-container,#eceae4);font-family:var(--font-sans);}
          .leaflet-popup-content-wrapper,.leaflet-popup-tip{border-radius:0;}
          .leaflet-popup-content a{font-family:var(--font-serif);color:var(--color-on-surface,#1a1a18);}`;
        document.head.appendChild(style);
        return (mod as any).default ?? mod;
      })();
    }
    return leafletPromise;
  }

  const initialized = new WeakSet<HTMLElement>();
  const mapInstances = new WeakMap<HTMLElement, any>();

  async function buildMap(container: HTMLElement, pins: Pin[]) {
    const L = await loadLeaflet();
    const map = L.map(container, {
      scrollWheelZoom: false,
      zoomAnimation: !reducedMotion,
      fadeAnimation: !reducedMotion,
      markerZoomAnimation: !reducedMotion,
    });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    pins.forEach((pin, i) => {
      L.marker([pin.lat, pin.lng], {
        icon: L.divIcon({
          className: '',
          html: `<span class="lg-pin">${i + 1}</span>`,
          iconSize: [26, 26],
          iconAnchor: [13, 13],
        }),
        title: pin.name,
        alt: pin.name,
        keyboard: true,
      })
        .addTo(map)
        .bindPopup(`<a href="${escapeHtml(pin.href)}">${escapeHtml(pin.name)}</a>`);
    });

    map.fitBounds(L.latLngBounds(pins.map((p) => [p.lat, p.lng])), {
      padding: [32, 32],
      maxZoom: 15,
    });
    mapInstances.set(container, map);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-map-toggle]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const container = document.getElementById(btn.dataset.mapTarget || '');
      if (!container) return;

      if (btn.getAttribute('aria-expanded') === 'true') {
        container.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        btn.textContent = 'View map';
        return;
      }

      container.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      btn.textContent = 'Hide map';

      let pins: Pin[] = [];
      try {
        pins = JSON.parse(btn.dataset.mapPins || '[]');
      } catch {
        pins = [];
      }
      if (pins.length === 0) return;

      if (!initialized.has(container)) {
        initialized.add(container);
        await buildMap(container, pins);
      } else {
        mapInstances.get(container)?.invalidateSize();
      }
    });
  });
</script>

<style>
  /* ── Jump nav ── */
  .lg-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .lg-jump-link {
    color: var(--color-on-surface-muted);
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-gallery);
  }

  .lg-jump-link:hover {
    color: var(--color-on-surface);
  }

  .lg-jump-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .lg-jump-count {
    color: var(--color-on-surface-muted);
    opacity: 0.65;
    margin-left: 0.4rem;
  }

  /* ── Search bar ── */
  .mosaic-search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 520px;
    padding: 0.625rem 0;
    margin-bottom: 1rem;
    border: 0;
    border-bottom: 1px solid var(--color-on-surface-variant);
  }

  .mosaic-search-icon {
    width: 18px;
    height: 18px;
    color: var(--color-on-surface-muted);
    margin-right: 0.875rem;
    flex-shrink: 0;
  }

  .mosaic-search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    outline: none;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-on-surface);
    padding: 0.125rem 0;
  }

  .mosaic-search-input::placeholder {
    color: var(--color-on-surface-muted);
  }

  /* Hide native clear button in WebKit so our custom button is the only one */
  .mosaic-search-input::-webkit-search-cancel-button,
  .mosaic-search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .mosaic-search-clear {
    background: none;
    border: 0;
    padding: 0.5rem;
    margin: -0.5rem -0.25rem -0.5rem 0.25rem;
    cursor: pointer;
    color: var(--color-on-surface-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color var(--duration-hover) var(--ease-gallery);
  }

  .mosaic-search-clear:hover {
    color: var(--color-on-surface);
  }

  .mosaic-search-count {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-surface-muted);
    margin-bottom: 2rem;
  }

  .mosaic-no-results {
    padding: clamp(3rem, 10vw, 6rem) 0;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--color-on-surface-variant);
  }

  /* ── Region sections ── */
  .lg-section {
    scroll-margin-top: 96px;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .lg-section-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .lg-section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    line-height: 1.15;
