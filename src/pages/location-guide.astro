---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FinalCTA from '../components/global/FinalCTA.astro';
import { Image } from 'astro:assets';

import locationsData from '../data/locations.json';
import portfolioData from '../data/portfolio.json';
import site from '../data/site.json';

const locationImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/locations/*.jpg',
  { eager: true }
);

const galleryImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/locations-gallery/**/*.{jpg,jpeg,JPG,JPEG}',
  { eager: true }
);

const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio/**/*.jpg',
  { eager: true }
);

// A location counts as "shot here" if either a gallery folder exists for its
// slug, or any portfolio entry's free-form `location` string contains the
// slug words (loose match handles "Aera Toronto, Downtown" vs "aera-toronto").
const portfolioLocStrings = portfolioData.map((p) => (p.location ?? '').toLowerCase());
const galleryPathSet = new Set(Object.keys(galleryImages));

const shotHereFor = (slug: string, name: string): boolean => {
  for (const path of galleryPathSet) {
    if (path.includes(`/locations-gallery/${slug}/`)) return true;
  }
  const slugWords = slug.replace(/-/g, ' ');
  const lname = name.toLowerCase();
  return portfolioLocStrings.some((loc) => loc.includes(slugWords) || loc.includes(lname));
};

const isPortrait = (img: ImageMetadata): boolean => img.height > img.width;

// For "shot here" tiles, prefer a real session frame over the stock location
// image. Priority: locations-gallery/<slug>/ first frame → matching portfolio
// entry first frame → stock image fallback. Within each source the first
// PORTRAIT frame wins, so the 4:5 card crop never zooms into a landscape.
const previewForShotLocation = (
  slug: string,
  name: string,
  fallback: ImageMetadata
): ImageMetadata => {
  const galleryKeys = Object.keys(galleryImages)
    .filter((p) => p.includes(`/locations-gallery/${slug}/`))
    .sort();
  if (galleryKeys.length > 0) {
    const portraitKey = galleryKeys.find((k) => isPortrait(galleryImages[k].default));
    return galleryImages[portraitKey ?? galleryKeys[0]].default;
  }

  const slugWords = slug.replace(/-/g, ' ');
  const lname = name.toLowerCase();
  const match = portfolioData.find((p) => {
    const loc = (p.location ?? '').toLowerCase();
    return loc.includes(slugWords) || loc.includes(lname);
  });
  if (match && Array.isArray(match.images) && match.images.length > 0) {
    const frames = match.images
      .map((file) => portfolioImages[`/src/assets/images/portfolio/${match.slug}/${file}`]?.default)
      .filter((img): img is ImageMetadata => Boolean(img));
    if (frames.length > 0) return frames.find(isPortrait) ?? frames[0];
  }

  return fallback;
};

// One quiet at-a-glance permit read per card. Any value outside these four
// renders no line at all rather than a guess.
const permitLines: Record<string, string> = {
  No: 'No permit needed',
  Sometimes: 'Permit sometimes needed',
  Yes: 'Permit required',
  'Venue booking': 'Book the venue first',
};

const sorted = [...locationsData].sort((a, b) => a.name.localeCompare(b.name));

const tiles = sorted
  .map((loc) => {
    const imgPath = `/src/assets/images/locations/${loc.image}`;
    const stockImg = locationImages[imgPath]?.default;
    if (!stockImg) return null;
    const shotHere = shotHereFor(loc.id, loc.name);
    const img = shotHere ? previewForShotLocation(loc.id, loc.name, stockImg) : stockImg;
    const permitLine = permitLines[loc.permitNeeded ?? ''] ?? null;
    return { ...loc, img, shotHere, permitLine };
  })
  .filter((t): t is NonNullable<typeof t> => t !== null);

// Six area groups built off the `zone` field. Every location lands in exactly
// one group; sessions I have actually shot lead each group, then the rest,
// both alphabetical (the `sorted` order carries through the filter).
const areaGroups = [
  { id: 'downtown-toronto', title: 'Downtown Toronto', zones: ['Downtown'] },
  { id: 'toronto-east', title: 'Toronto East', zones: ['Bluffs', 'Scarborough'] },
  { id: 'toronto-west', title: 'Toronto West', zones: ['Etobicoke'] },
  {
    id: 'mississauga-burlington-vaughan',
    title: 'Mississauga, Burlington & Vaughan',
    zones: ['Mississauga', 'Burlington', 'Vaughan'],
  },
  { id: 'hamilton-dundas', title: 'Hamilton & Dundas', zones: ['Hamilton'] },
  { id: 'niagara', title: 'Niagara', zones: ['Niagara'] },
];

const groups = areaGroups
  .map((group) => {
    const inGroup = tiles.filter((t) => group.zones.includes(t.zone));
    return {
      ...group,
      tiles: [...inGroup.filter((t) => t.shotHere), ...inGroup.filter((t) => !t.shotHere)],
    };
  })
  .filter((group) => group.tiles.length > 0);

const locationListSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Best Photography Locations in Toronto & the GTA',
    description: 'Curated photography locations across Toronto and the GTA by AD Photography, with parking, permits, and session tips.',
    url: `${site.url}/location-guide`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Best Photography Locations in Toronto',
    description: 'Curated photography locations in Toronto and the GTA by AD Photography',
    url: `${site.url}/location-guide`,
    numberOfItems: tiles.length,
    itemListElement: tiles.map((loc, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${site.url}/location-guide/${loc.id}`,
      item: {
        '@type': 'Place',
        name: loc.name,
        description: loc.vibe,
        url: `${site.url}/location-guide/${loc.id}`,
        address: {
          '@type': 'PostalAddress',
          addressLocality: loc.area,
          addressRegion: 'ON',
          addressCountry: 'CA',
        },
      },
    })),
  },
];
---

<BaseLayout
  title="Best Photography Locations in Toronto & the GTA"
  description="Curated Toronto and GTA photography locations for pre-wedding, engagement, and portrait sessions. Parking, permits, and best times for each."
  jsonLd={locationListSchema}
>
  <div class="container-editorial" style="padding-top: var(--spacing-block); padding-bottom: var(--spacing-block);">
    <div class="sr-only">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Location Guide', href: '/location-guide/' },
      ]} />
    </div>

    <header style="margin-bottom: var(--spacing-block);">
      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-6 items-end">
        <div class="md:col-span-5 reveal">
          <p class="text-label-md text-on-surface-muted eyebrow-rule mb-4">Location Guide</p>
          <h1 class="text-display-md reveal stagger-1">Toronto Location Guide</h1>
        </div>
        <div class="md:col-span-6 md:col-start-7 mt-6 md:mt-0 reveal stagger-2">
          <p class="text-body-lg text-on-surface-variant measure-wide">
            Every place I shoot across Toronto and the GTA, grouped by area. Each card shows the place, the feel of it, and what it works best for. Tap any location for the full rundown: parking, permits, walking, best seasons.
          </p>
        </div>
      </div>
    </header>

    <nav class="lg-jump reveal" aria-label="Browse by area">
      {groups.map((group) => (
        <a class="lg-jump-link text-label-md" href={`#${group.id}`}>
          {group.title}
          <span class="lg-jump-count">{group.tiles.length}</span>
        </a>
      ))}
    </nav>

    <form class="mosaic-search reveal" role="search" autocomplete="off" onsubmit="return false;">
      <label for="location-search" class="sr-only">Search locations</label>
      <svg class="mosaic-search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="7" />
        <path stroke-linecap="round" d="m20 20-3.5-3.5" />
      </svg>
      <input
        id="location-search"
        type="search"
        placeholder="Search by name, area, vibe, or season"
        class="mosaic-search-input"
        data-search-input
      />
      <button type="button" class="mosaic-search-clear" aria-label="Clear search" data-search-clear hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6l-12 12" />
        </svg>
      </button>
    </form>

    <p class="mosaic-search-count" aria-live="polite">
      Showing <span data-search-count>{tiles.length}</span> of {tiles.length} locations
    </p>

    {groups.map((group, groupIndex) => (
      <section id={group.id} class="lg-section reveal">
        <header class="lg-section-header">
          <h2 class="lg-section-title">{group.title}</h2>
          <p class="lg-section-count text-label-sm text-on-surface-muted">
            {group.tiles.length} {group.tiles.length === 1 ? 'location' : 'locations'}
          </p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-10">
          {group.tiles.map((loc, i) => (
            <a
              href={`/location-guide/${loc.id}/`}
              class="lg-card group block reveal"
              aria-label={`View details for ${loc.name}`}
              data-search-haystack={`${loc.name} ${loc.area} ${loc.vibe} ${loc.bestFor.join(' ')} ${loc.setting.join(' ')} ${loc.zone} ${loc.season.join(' ')} ${loc.permitLine ?? ''}`.toLowerCase()}
              style={`transition-delay: ${(i % 6) * 80 + 100}ms;`}
            >
              <div class="lg-card-media aspect-[4/5] overflow-hidden bg-surface-container">
                <Image
                  src={loc.img}
                  alt={`${loc.name}, pre-wedding and engagement photography location in ${loc.area}`}
                  widths={[400, 640, 960]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  class="w-full h-full object-cover cubic-ease group-hover:scale-[1.03]"
                  style="transition-duration: var(--duration-slow);"
                  loading={groupIndex === 0 && i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={groupIndex === 0 && i === 0 ? 'high' : 'auto'}
                />
                {loc.shotHere && (
                  <span class="lg-session-label text-label-sm">From a session here</span>
                )}
              </div>

              <div class="mt-4">
                <h3 class="text-heading-md font-serif">{loc.name}</h3>
                <p class="text-label-sm text-on-surface-muted mt-1">{loc.area}</p>
                <p class="lg-vibe text-body-md text-on-surface-variant mt-3">{loc.vibeLine ?? loc.vibe}</p>
                {loc.bestFor.length > 0 && (
                  <p class="text-label-sm text-on-surface-muted mt-3">{loc.bestFor.slice(0, 3).join(' · ')}</p>
                )}
                {loc.permitLine && (
                  <p class="lg-permit text-label-sm mt-2">{loc.permitLine}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="mosaic-no-results" data-search-empty hidden>
      No locations match that search. Try a city, a vibe, or a season.
    </p>

  </div>

  <FinalCTA
    eyebrow="Still deciding?"
    title="Not sure where to shoot?"
    body="Location guidance is included with every package. I'll help you find the perfect spot."
    useBookingLink={true}
    bookingLabel="Book a Consultation"
    background="surface-dim"
  />
</BaseLayout>

<script>
  // Client-side filter for the location guide cards. Matches against
  // name, area, vibe, tags, setting, zone, and season (all lowercased
  // into data-search-haystack server-side).
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const tiles = document.querySelectorAll<HTMLElement>('[data-search-haystack]');
  const countEl = document.querySelector<HTMLElement>('[data-search-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-search-empty]');
  const sections = document.querySelectorAll<HTMLElement>('.lg-section');

  function applyFilter() {
    if (!input) return;
    const q = input.value.trim().toLowerCase();
    let matches = 0;
    tiles.forEach((tile) => {
      const haystack = tile.dataset.searchHaystack || '';
      const show = !q || haystack.includes(q);
      tile.hidden = !show;
      if (show) matches++;
    });
    // Hide an area section (heading included) when none of its cards match
    sections.forEach((sec) => {
      const visible = Array.from(
        sec.querySelectorAll<HTMLElement>('[data-search-haystack]')
      ).some((t) => !t.hidden);
      sec.hidden = !visible;
    });
    if (countEl) countEl.textContent = String(matches);
    if (clearBtn) clearBtn.hidden = q.length === 0;
    if (emptyEl) emptyEl.hidden = matches > 0;
  }

  input?.addEventListener('input', applyFilter);
  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    input.focus();
    applyFilter();
  });
</script>

<style>
  /* ── Jump nav ── */
  .lg-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .lg-jump-link {
    color: var(--color-on-surface-muted);
    text-decoration: none;
    transition: color var(--duration-hover) var(--ease-gallery);
  }

  .lg-jump-link:hover {
    color: var(--color-on-surface);
  }

  .lg-jump-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .lg-jump-count {
    color: var(--color-on-surface-muted);
    opacity: 0.65;
    margin-left: 0.4rem;
  }

  /* ── Search bar ── */
  .mosaic-search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 520px;
    padding: 0.625rem 0;
    margin-bottom: 1rem;
    border: 0;
    border-bottom: 1px solid var(--color-on-surface-variant);
  }

  .mosaic-search-icon {
    width: 18px;
    height: 18px;
    color: var(--color-on-surface-muted);
    margin-right: 0.875rem;
    flex-shrink: 0;
  }

  .mosaic-search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    outline: none;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-on-surface);
    padding: 0.125rem 0;
  }

  .mosaic-search-input::placeholder {
    color: var(--color-on-surface-muted);
  }

  /* Hide native clear button in WebKit so our custom button is the only one */
  .mosaic-search-input::-webkit-search-cancel-button,
  .mosaic-search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .mosaic-search-clear {
    background: none;
    border: 0;
    padding: 0.5rem;
    margin: -0.5rem -0.25rem -0.5rem 0.25rem;
    cursor: pointer;
    color: var(--color-on-surface-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color var(--duration-hover) var(--ease-gallery);
  }

  .mosaic-search-clear:hover {
    color: var(--color-on-surface);
  }

  .mosaic-search-count {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-surface-muted);
    margin-bottom: 2rem;
  }

  .mosaic-no-results {
    padding: clamp(3rem, 10vw, 6rem) 0;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--color-on-surface-variant);
  }

  /* ── Area sections ── */
  .lg-section {
    scroll-margin-top: 96px;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .lg-section-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .lg-section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-on-surface);
    max-width: 26ch;
  }

  .lg-section-count {
    margin-top: 0.5rem;
  }

  /* ── Location card ── */
  .lg-card {
    color: inherit;
    text-decoration: none;
  }

  .lg-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .lg-card-media {
    position: relative;
  }

  /* Scrim sits behind the label only, so it reads on any photo without
     darkening the frame. */
  .lg-session-label {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.4rem 0.625rem;
    background: rgba(20, 20, 18, 0.55);
    color: var(--color-on-dark);
    pointer-events: none;
  }

  .lg-permit {
    color: var(--color-on-surface-variant);
  }

  .lg-vibe {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
