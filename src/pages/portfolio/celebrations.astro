---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import PortfolioCard from '../../components/ui/PortfolioCard.astro';
import Button from '../../components/ui/Button.astro';
import PortfolioFinalCTA from '../../components/global/PortfolioFinalCTA.astro';
import { Image } from 'astro:assets';

import portfolio from '../../data/portfolio.json';
import site from '../../data/site.json';

const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio/*.jpg',
  { eager: true }
);

const ctaImage = (await import('../../assets/images/homepage/celebrations-cta.jpg')).default;

// See pre-weddings.astro for what `alsoIn` does.
const entries = portfolio
  .filter((p: any) => p.category === 'celebrations' || p.alsoIn?.includes('celebrations'))
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const businessRef = { '@id': `${site.url}/#business` };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Toronto Celebration and Event Photography Gallery, AD Photography',
  description: 'Anniversary, birthday, and family celebration photography portfolio in Toronto and the GTA by AD Photography.',
  url: new URL('/portfolio/celebrations/', Astro.site).href,
  creator: { '@type': 'LocalBusiness', name: 'AD Photography', ...businessRef },
  image: entries.map((entry) => ({
    '@type': 'ImageObject',
    name: `${entry.couple}, Celebration`,
    description: `Celebration photography of ${entry.couple} at ${entry.location}`,
    contentLocation: { '@type': 'Place', name: entry.location },
  })),
};
---

<BaseLayout
  title="Toronto Celebration & Event Photography Portfolio"
  description="Browse my Toronto celebration and event photography portfolio. Anniversaries, birthdays, and family parties across Toronto and the GTA."
  jsonLd={schema}
>
  <div class="sr-only">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Portfolio', href: '/portfolio/' },
      { label: 'Celebrations', href: '/portfolio/celebrations/' },
    ]} />
  </div>

  <!-- ═══ GALLERY ═══ -->
  <section class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-end" style="margin-bottom: var(--spacing-block);">
        <div class="col-span-12 md:col-span-7 reveal">
          <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">Celebrations</p>
          <h1 class="section-title char-reveal">The nights worth <em>flying home for.</em></h1>
        </div>
        <div class="col-span-12 md:col-span-5 md:col-start-8 mt-6 md:mt-0 reveal stagger-2">
          <p class="section-deck text-on-surface-variant measure-wide">
            Anniversaries, birthdays, and the parties people fly in for, across Toronto and the GTA. I photograph the whole room, from the food table to the last dance.
          </p>
        </div>
      </div>

      {entries.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-20">
          {entries.map((entry, i) => {
            const imgPath = `/src/assets/images/portfolio/${entry.coverImage}`;
            const img = portfolioImages[imgPath]?.default;
            return img ? (
              <div class:list={['reveal', `stagger-${(i % 5) + 1}`, i % 3 === 1 ? 'lg:mt-24' : '']}>
                <PortfolioCard
                  couple={entry.couple}
                  location={entry.location}
                  category={entry.category}
                  coverImage={img}
                  href={`/portfolio/${entry.slug ?? entry.id}/`}
                  date={entry.date ?? null}
                  priority={i < 2}
                />
              </div>
            ) : null;
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-body-lg text-on-surface-muted">New celebrations coming soon. Check back or browse my other chapters.</p>
          <div class="mt-8">
            <span class="magnetic inline-block"><Button href="/portfolio/" variant="secondary">View All Work</Button></span>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ PHILOSOPHY ═══ -->
  <section class="bg-background" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="max-w-3xl mx-auto text-center reveal">
        <p class="text-quote">
          "A room full of your people is worth keeping."
        </p>
      </div>
    </div>
  </section>

  <PortfolioFinalCTA
    title="Book the night."
    body="Planning a celebration? Send me the date and a few details, and I will tell you exactly how I would cover the night."
    ctaLabel="Begin The Conversation"
    ctaHref="/contact/?service=celebrations#inquiry"
    image={ctaImage}
    imageAlt="Toronto celebration photography by AD Photography"
    imageCaption="The Whole Night"
  />
</BaseLayout>
