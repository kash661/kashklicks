    color: var(--color-on-surface-variant);
    text-decoration-color: var(--color-on-surface-variant);
  }

  /* ── Packages: four cards. Two by two from 1024px, one row of four from
     1280px, where the card padding and name size step down to fit. Below
     1024px the cards are the tap to open accordion rows. ─────────────── */
  @media (min-width: 1024px) {
    .mq-pricing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
