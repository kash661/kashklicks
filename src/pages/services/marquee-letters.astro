  }

  .mq-link:hover .mq-link__arrow {
    transform: translateX(3px);
  }

  .mq-inline-link {
    color: var(--color-on-surface);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--color-on-surface) 35%, transparent);
    transition: text-decoration-color var(--duration-hover) var(--ease-gallery);
  }

  .mq-inline-link:hover {
    text-decoration-color: var(--color-on-surface);
  }

  .mq-link:focus-visible,
  .mq-inline-link:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 4px;
  }

  /* Press: the underline goes solid and the text dips a shade, at once. */
  .mq-link:active,
