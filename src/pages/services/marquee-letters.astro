<style>
  /* Hallmark · macrostructure: digital-curator-service-page (split studio rows) · design-system: .claude/CLAUDE.md
   * contrast: pass (46 to 50) · honest: pass (56) · chrome: pass (57) · tokens: pass (58) · responsive: pass (59, 61 to 66) · icons: none
   */

  /* Page tokens. Every value below resolves to the locked Digital Curator
     tokens in global.css; the only new names are this page's hairline. */
  .mq-page {
    --mq-rule: color-mix(in srgb, var(--color-on-surface-variant) 22%, transparent);
  }

  /* scroll-margin keeps an anchored heading (#packages, #delivery) clear of
     the 64px fixed header on phones, where the section padding is smaller. */
  .mq-section {
    padding-block: var(--spacing-section);
    scroll-margin-top: 4rem;
  }

  /* A short band between two long sections breathes on less padding, so the
     page rhythm is not one even beat. */
  .mq-section--tight {
    padding-block: var(--spacing-block);
  }

  .mq-section-head {
    margin-bottom: var(--spacing-block);
  }

  /* Headings wrap between words, never out of the column. */
  .mq-title {
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .mq-title em {
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--color-on-surface-variant);
  }

  .mq-lede {
    margin-top: 1.5rem;
    max-width: 38rem;
  }

  .mq-note {
    margin-top: 1rem;
    max-width: 36rem;
  }

  /* Asymmetric two column sections: a rail on the left, the proof on the
     right. Stacked below 1024px, so the gap becomes the vertical rhythm. */
  .mq-split {
    row-gap: 2.5rem;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .mq-hero {
    padding-block: var(--spacing-block) var(--spacing-section);
  }

  .mq-hero__grid {
    row-gap: var(--spacing-block);
  }

  .mq-hero__deck {
    margin-top: 1.5rem;
    max-width: 34rem;
  }

  /* Label and value rows separated by space alone, no hairlines. */
  .mq-facts {
    margin: 2.5rem 0 0;
    max-width: 38rem;
  }

  .mq-facts__item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: 1.25rem;
    padding-block: 0.75rem;
  }

  .mq-facts__label {
    padding-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .mq-facts__value {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-on-surface);
  }

  /* The smallest phones: the value column would be under 100px beside the
     label, so the label sits above its value instead. */
  @media (max-width: 379px) {
    .mq-facts__item {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.25rem;
    }
  }

  .mq-hero__figure {
    margin: 0;
  }

  /* Below the desktop split the plate steps to the right edge at a sane
     size, so a tablet never gets a 900px tall block of dark stone. */
  @media (max-width: 1023px) {
    .mq-hero__figure {
      width: min(100%, 30rem);
      margin-inline-start: auto;
    }
  }

  /* ── Buttons: default, hover, focus-visible, active. They are links out
     (WhatsApp, Instagram) or anchors, so there is no loading, error or
     disabled state to design. ─────────────────────────────────────────── */
  .mq-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .mq-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 1rem 1.75rem;
    border: 1px solid transparent;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--duration-hover) var(--ease-gallery),
      color var(--duration-hover) var(--ease-gallery),
      border-color var(--duration-hover) var(--ease-gallery),
      transform 150ms var(--ease-gallery);
