              target="_blank"
              rel="noopener noreferrer"
              class="mq-btn mq-btn--primary"
              data-service={MARQUEE_SERVICE}
              data-cta="whatsapp-final"
            >
              Check your date<span class="sr-only">, opens WhatsApp</span>
              <span class="mq-btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a
              href={instagramDm}
              target="_blank"
              rel="noopener noreferrer"
              class="mq-btn mq-btn--line"
              data-service={MARQUEE_SERVICE}
              data-cta="instagram-final"
            >
              DM us on Instagram
            </a>
            <p class="mq-final__note">WhatsApp opens with a message already started for you.</p>
          </div>
        </div>
      </div>
    </section>

    <FloatingPackagesLink />

    <script>
      // Count marquee inquiries. Every booking path here opens WhatsApp or
      // Instagram, so no form fires the site's lead events. One delegated
      // listener tags each tap with the button it came from: data-cta, else
      // the package card, else the floating WhatsApp button. trackCustom only,
      // never Lead or Contact, so the photography ad optimisation is untouched.
      // Read the marquee_* events in Clarity. The site has no ClientRouter, so
      // this runs on this page only.
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>(
          'a[href^="https://wa.me/"], a[href^="https://ig.me/"]'
        );
        if (!a) return;
        const pkg = a.dataset.package?.replace(/^marquee-/, 'package-');
        const cta = a.dataset.cta ?? pkg ?? (a.classList.contains('wa-fab') ? 'wa-fab' : 'inline');
        const w = window as unknown as {
          clarity?: (...args: unknown[]) => void;
          fbq?: (...args: unknown[]) => void;
        };
        // Analytics must never get in the way of the chat opening.
        try { w.clarity?.('event', `marquee_${cta}`); } catch { /* noop */ }
        try { w.fbq?.('trackCustom', 'MarqueeMessageClick', { cta }); } catch { /* noop */ }
      });
    </script>
