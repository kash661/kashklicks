---
/*
 * Hallmark · macrostructure: digital-curator-service-page · theme: locked design system · design-system: .claude/CLAUDE.md
 * page: Toronto surprise proposal (service page) · sibling of services/headshots.astro
 * honest-copy: hero is a statement, NOT a review. There are no proposal reviews
 *   to quote yet, and the Google reviews are from wedding, pre-wedding and event
 *   clients, so quoting one under a proposal would misattribute it.
 * Every claim on this page traces to the "proposal" package in packages.json,
 * to locations.json, or to a gallery in portfolio.json. Nothing invented.
 * no fabricated metrics/testimonials · no em/en dashes · tokens + components reused
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import PricingCard from '../../components/ui/PricingCard.astro';
import ReviewStrip from '../../components/global/ReviewStrip.astro';
import PackageAddOns from '../../components/ui/PackageAddOns.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import BookingLink from '../../components/ui/BookingLink.astro';
import ShareButton from '../../components/ui/ShareButton.astro';
import JourneyTimeline from '../../components/services/JourneyTimeline.astro';
import PortfolioFinalCTA from '../../components/global/PortfolioFinalCTA.astro';
import ContactModal from '../../components/global/ContactModal.astro';
import FloatingPackagesLink from '../../components/global/FloatingPackagesLink.astro';
import { Image } from 'astro:assets';

import packages from '../../data/packages.json';
import faqData from '../../data/faq.json';
import locationsData from '../../data/locations.json';
import site from '../../data/site.json';

import heroImage from '../../assets/images/portfolio/margarita-mike/05.jpg';
import hiddenImage from '../../assets/images/portfolio/ashley-donald/03.jpg';
import momentImage from '../../assets/images/portfolio/lavina-raeed/06.jpg';
import momentImageTwo from '../../assets/images/portfolio/margarita-mike/12.jpg';
import ctaImage from '../../assets/images/portfolio/ashley-donald/10.jpg';

const proposalPackages = packages
  .filter((p) => p.category === 'Proposals')
  .sort((a, b) => a.order - b.order);
const proposalFaq = faqData.filter((q: any) => q.services && q.services.includes('proposal'));

const proposalService = {
  title: 'Proposals',
  description:
    'You plan the question. I plan where to stand. I get to the spot early and set up well back with a long lens, so the whole thing is photographed while your partner has no idea anyone is watching. The second it is over I walk in, and the rest of the hour belongs to the two of you while it is still sinking in.',
  includes: [
    '1 hour of discreet coverage',
    'Around 80 photos',
    'Fujifilm film simulation photos delivered next day',
    'Remaining photos fully edited after',
    'Help planning the spot and timing',
    'Private online gallery',
  ],
};

// Fast facts. Every value is copied from the proposal package in packages.json
// or from the includes list above, so the block cannot drift into a claim the
// rest of the page does not already make.
const proposalFastFacts = [
  { label: 'Price', value: 'The Proposal is $325. One hour of coverage at one spot.' },
  { label: 'How the hour splits', value: 'Hidden while you ask, then a mini shoot with the two of you once you hear yes.' },
  { label: 'Photos', value: 'Around 80 from the hour.' },
  { label: 'Delivery', value: 'Your Fujifilm film simulation photos land the next day. The rest follow fully edited.' },
  { label: 'Planning', value: 'I help you choose the spot and the time of day before the date.' },
  { label: 'Where I shoot', value: 'Toronto and the GTA.' },
];

// Proposal spots, pulled from locations.json so the names, areas, one-liners and
// permit status stay in sync with the location guide instead of being retyped.
const proposalSpotIds = [
  'music-garden',
  'humber-bay-arch-bridge',
  'distillery-district',
  'high-park',
  'toronto-islands',
  'scarborough-bluffs',
  'guild-park',
  'evergreen-brick-works',
];

const permitLabels: Record<string, string> = {
  No: 'No permit needed',
  Sometimes: 'Permit sometimes needed',
  Yes: 'Permit required',
};

const proposalSpots = proposalSpotIds
  .map((id) => (locationsData as any[]).find((loc) => loc.id === id))
  .filter(Boolean)
  .map((loc) => ({
    id: loc.id,
    name: loc.name,
    area: loc.area,
    line: loc.vibeLine,
    permit: permitLabels[loc.permitNeeded] ?? 'Check the permit table',
  }));

const businessRef = { '@id': `${site.url}/#business` };

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Toronto Surprise Proposal Photography',
  description: proposalService.description,
  provider: businessRef,
  areaServed: { '@type': 'City', name: 'Toronto' },
  serviceType: 'Proposal Photography',
  image: `${site.url}/og-default.jpg`,
};

const offerCatalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Proposal Photography Packages',
  description: 'Toronto surprise proposal photography by AD Photography. One hour of discreet coverage from $325.',
  url: `${site.url}/services/proposal`,
  offeredBy: businessRef,
  itemListElement: proposalPackages.filter((p) => p.price !== null).map((p) => ({
    '@type': 'Offer',
    name: p.name,
    description: p.description,
    price: p.salePrice || p.price,
    priceCurrency: p.currency,
    availability: 'https://schema.org/InStock',
    seller: businessRef,
  })),
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: proposalFaq.map((q: any) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
};

const jsonLd = [serviceSchema, offerCatalogSchema, faqPageSchema];

const proposalJourneySteps = [
  {
    label: 'Step 01',
    title: 'Tell Me The Plan',
    body: 'Send me the date you are thinking about and whatever you have worked out so far. A few messages is usually enough to get started.',
  },
  {
    label: 'Step 02',
    title: 'Pick The Spot',
    body: 'We choose the location and the time of day together. I am looking for good light, a clear sightline, and somewhere I can stand without being obvious.',
  },
  {
    label: 'Step 03',
    title: 'I Disappear',
    body: 'I get there early and set up well back with a long lens. By the time the two of you walk in, I look like one more person photographing the view.',
  },
  {
    label: 'Step 04',
    title: 'The Question',
    body: 'You ask. I photograph all of it from a distance, including the few seconds afterward that nobody ever remembers clearly.',
  },
  {
    label: 'Step 05',
    title: 'The Mini Shoot',
    body: 'Once it lands I walk over and introduce myself, and the rest of the hour is the two of you. Around 80 photos across the whole thing.',
  },
  {
    label: 'Step 06',
    title: 'Next Day, Then The Rest',
    body: 'Your Fujifilm film simulation photos are in your inbox the next day, so you have something to send your family right away. The remaining photos follow fully edited.',
  },
];
---

<BaseLayout
  title="Toronto Proposal Photographer"
  description="Surprise proposal photography in Toronto and the GTA from $325. One hour of hidden coverage, around 80 photos, and your Fujifilm photos the next day."
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs (visually hidden, still crawled by Google for search snippets) -->
  <div class="sr-only">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services/' },
      { label: 'Proposals', href: '/services/proposal/' },
    ]} />
  </div>

  <!-- Hero: Statement + portrait image.
       No review here on purpose: there are no proposal reviews yet, and the
       Google reviews on file are from wedding, pre-wedding and event clients. -->
  <section style="padding-top: var(--spacing-block); padding-bottom: var(--spacing-block);">
    <div class="container-editorial">
      <div class="grid-editorial items-center" style="min-height: 80svh;">
        <!-- Statement -->
        <div class="col-span-12 md:col-span-5 reveal">
          <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">Proposals</p>
          <blockquote class="text-display-md" style="max-width: 20ch;">
            The ten seconds after you ask only happen once.
          </blockquote>
          <p class="text-label-sm text-on-surface-muted mt-8">Surprise proposals &middot; Photographed from a distance &middot; Toronto and the GTA</p>
          <div class="mt-8">
            <ShareButton
              variant="labeled"
              url="/services/proposal/"
              title="Toronto Proposal Photography, AD Photography"
              text="Surprise proposal coverage in Toronto from $325, with your first photos the next day."
              label="Share"
            />
          </div>
        </div>
        <!-- Portrait image + plaque -->
        <figure class="col-span-12 md:col-span-6 md:col-start-7 reveal-right stagger-2">
          <div class="aspect-[3/4] overflow-hidden hover-zoom">
            <Image
              src={heroImage}
              alt="Mike on one knee proposing to Margarita under the pergola at the Toronto Music Garden, with the CN Tower rising behind them, by AD Photography"
              widths={[640, 960, 1280]}
              sizes="(max-width: 768px) 100vw, 50vw"
              quality={75}
              format="avif"
              class="w-full h-full object-cover parallax-img"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="gallery-plaque">
            <div class="gallery-plaque__line">
              <span class="gallery-plaque__plate">Proposal</span>
              <span class="gallery-plaque__rule" aria-hidden="true"></span>
              <span class="gallery-plaque__meta">Toronto Music Garden</span>
            </div>
            <p class="gallery-plaque__title">Margarita <em>&amp;</em> Mike</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICE DESCRIPTION ═══ -->
  <section class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-center" style="margin-bottom: var(--spacing-block);">
        <div class="col-span-12 lg:col-span-5 aspect-[3/4] overflow-hidden reveal-left hover-zoom order-2 lg:order-1 mt-10 lg:mt-0">
          <Image
            src={hiddenImage}
            alt="Donald down on one knee as Ashley covers her mouth beside the rose garden fountain at Chateau des Charmes, photographed from a distance, by AD Photography"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 100vw, 42vw"
            quality={75}
            class="w-full h-full object-cover parallax-img"
            loading="lazy"
          />
        </div>
        <div class="col-span-12 lg:col-span-6 lg:col-start-7 reveal stagger-2 order-1 lg:order-2">
          <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">What I Offer</p>
          <h1 class="section-title char-reveal">Toronto proposal <em>photography.</em></h1>
          <p class="section-deck text-on-surface-variant mt-8 measure-wide">{proposalService.description}</p>
          <p class="text-label-sm text-on-surface-muted uppercase tracking-widest mt-10 mb-4">What's Included</p>
          <ul class="space-y-3">
            {proposalService.includes.map((item) => (
              <li class="text-body-md text-on-surface-variant pl-5 relative">
                <span class="absolute left-0 top-0 text-on-surface-muted" aria-hidden="true">/</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- ═══ FAST FACTS: plain answers for search results and AI summaries ═══ -->
      <div class="grid-editorial" style="margin-bottom: var(--spacing-block);">
        <div class="col-span-12 lg:col-span-10 lg:col-start-2 reveal stagger-3">
          <h2 class="text-label-sm text-on-surface-muted uppercase tracking-widest mb-6">Surprise proposal shoots at a glance</h2>
          <dl>
            {proposalFastFacts.map((fact) => (
              <div class="border-t border-on-surface-muted/20 py-4 md:grid md:grid-cols-12 md:gap-6">
                <dt class="text-label-sm text-on-surface uppercase tracking-widest md:col-span-4">{fact.label}</dt>
                <dd class="text-body-md text-on-surface-variant mt-2 md:mt-0 md:col-span-8">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Scroll indicator to packages -->
      <a
        href="#packages"
        aria-label="Scroll to packages"
        class="group flex flex-col items-center mt-16 reveal stagger-3 cursor-pointer focus:outline-none focus-visible:[outline:2px_solid_var(--color-on-surface-muted)] focus-visible:[outline-offset:8px]"
      >
        <span class="text-label-sm text-on-surface-muted group-hover:text-on-surface group-focus-visible:text-on-surface mb-3 cubic-ease" style="transition-duration: var(--duration-hover-ui);">The Package</span>
        <span class="scroll-chevron text-on-surface-muted group-hover:text-on-surface group-focus-visible:text-on-surface cubic-ease" style="transition-duration: var(--duration-hover-ui);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </a>
    </div>
  </section>

  <!-- ═══ THE PROPOSAL PACKAGE ═══ -->
  <section id="packages" class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-end" style="margin-bottom: var(--spacing-block);">
        <div class="col-span-12 md:col-span-7">
          <p class="text-label-md text-on-surface-muted reveal eyebrow-rule mb-6">One Hour, One Question</p>
          <h2 class="section-title reveal stagger-1">The proposal <em>package.</em></h2>
        </div>
        <div class="col-span-12 md:col-span-5 md:col-start-8 mt-6 md:mt-0">
          <p class="section-deck text-on-surface-variant reveal stagger-2 measure-wide">
            One package, because a proposal is one hour and one spot. Most photographers hand back 25 to 50 frames a week or two later. You get around 80, and the Fujifilm film simulation set is in your inbox the next day.
          </p>
        </div>
      </div>

      <ReviewStrip class="reveal mb-12" />
      {/*
        Wrapped in .pricing-grid so the single card picks up the same flex
        fallback the other one-package pages use. No #package-grid id, so the
        mobile accordion controller leaves the card fully open.
      */}
      <div class="pricing-grid reveal stagger-3">
        {proposalPackages.map((pkg, i) => (
          <PricingCard
            id={pkg.id}
            name={pkg.name}
            price={pkg.price}
            salePrice={pkg.salePrice}
            badge={pkg.badge}
            description={pkg.description}
            highlights={pkg.highlights}
            popular={pkg.popular}
            featured={!!pkg.salePrice}
            ordinal={i}
            service="proposal"
            ctaLabel="Enquire"
            coverage="photo"
            accordion={true}
            accordionTag={pkg.duration}
          />
        ))}
      </div>

      <!-- Shared add-ons section (pulled from the proposal package above) -->
      <div class="mt-12">
        <PackageAddOns
          title="Add-Ons & Extras"
          description="Optional upgrades you can add to the proposal session."
          packages={proposalPackages}
        />
      </div>

      <!-- CTA below packages -->
      <div class="text-center mt-16 reveal">
        <p class="text-label-sm text-on-surface-muted mb-2">Have questions? I'll get back to you within 24 hours, guaranteed.</p>
        <div class="mt-6">
          <a href="/contact/?service=proposal" class="magnetic inline-flex items-center justify-center whitespace-nowrap px-12 py-5 bg-primary text-on-dark font-sans text-label-md hover:bg-primary-hover cubic-ease" style="transition-duration: var(--duration-hover);">Contact Me</a>
        </div>
      </div>
    </div>
  </section>

  <JourneyTimeline
    steps={proposalJourneySteps}
    eyebrow="How It Works"
    title="From The Plan To The Yes"
  />

  <!-- ═══ CALENDLY CTA (post-journey) ═══ -->
  <section class="bg-background" style="padding: 0 0 var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="text-center reveal">
        <h3 class="text-heading-lg font-serif mb-2">Ready to start?</h3>
        <p class="text-body-md text-on-surface-variant mb-8">Book a free 30-minute consultation call</p>
        <BookingLink variant="primary" label="Book Your Call" />
      </div>
    </div>
  </section>

  <!-- ═══ EDITORIAL INTERLUDE ═══
       Offset photo pair borrowed from the homepage signature section: the
       narrower right frame drops below the left one so the row never reads
       as a symmetrical two-up. -->
  <section class="bg-surface" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-center">
        <div class="col-span-12 md:col-span-3 reveal">
          <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">The Difference</p>
          <p class="text-quote text-on-surface-variant" style="max-width: 24ch;">
            The frame you keep is the one right after, when nobody is thinking about a camera.
          </p>
          <p class="mt-8">
            <a href="/portfolio/proposals/" class="text-label-sm border-b border-on-surface-muted hover:border-on-surface cubic-ease" style="transition-duration: var(--duration-hover);">Browse the proposal galleries &rarr;</a>
          </p>
        </div>
        <figure class="col-span-12 md:col-span-4 md:col-start-5 mt-10 md:mt-0 reveal-left stagger-2">
          <div class="aspect-[3/4] overflow-hidden hover-zoom">
            <Image
              src={momentImage}
              alt="Raeed on one knee with the open ring box, the carved stone arch of Guild Park and Gardens behind him in Scarborough, by AD Photography"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 33vw"
              quality={75}
              class="w-full h-full object-cover parallax-img"
              loading="lazy"
            />
          </div>
        </figure>
        <figure class="col-span-12 md:col-span-3 md:col-start-10 mt-3 md:mt-24 reveal-right stagger-3">
          <div class="aspect-[3/4] overflow-hidden hover-zoom">
            <Image
              src={momentImageTwo}
              alt="Mike lifting Margarita off the ground at the Toronto Music Garden with the CN Tower in the background, by AD Photography"
              widths={[320, 480, 640]}
              sizes="(max-width: 768px) 100vw, 25vw"
              quality={75}
              class="w-full h-full object-cover parallax-img"
              loading="lazy"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ═══ WHERE PEOPLE PROPOSE ═══
       Rows are built from locations.json, so the names, one-liners and permit
       status here can never drift from the location guide pages they link to. -->
  <section class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-end" style="margin-bottom: var(--spacing-block);">
        <div class="col-span-12 md:col-span-7">
          <p class="text-label-md text-on-surface-muted reveal eyebrow-rule mb-6">Where People Propose</p>
          <h2 class="section-title reveal stagger-1">Toronto proposal <em>spots.</em></h2>
        </div>
        <div class="col-span-12 md:col-span-5 md:col-start-8 mt-6 md:mt-0">
          <p class="section-deck text-on-surface-variant reveal stagger-2 measure-wide">
            Eight places in and around the city where a surprise actually works, which usually comes down to somewhere I can stand well back without being seen. Every one links to the full guide with parking, light and permit notes.
          </p>
        </div>
      </div>

      <div class="grid-editorial">
        <div class="col-span-12 lg:col-span-10 lg:col-start-2 reveal stagger-3">
          <ul role="list">
            {proposalSpots.map((spot) => (
              <li class="border-t border-on-surface-muted/20">
                <a
                  href={`/location-guide/${spot.id}/`}
                  class="group block py-6 md:grid md:grid-cols-12 md:gap-6 cubic-ease"
                  style="transition-duration: var(--duration-hover);"
                >
                  <div class="md:col-span-4">
                    <p class="text-heading-md font-serif group-hover:italic cubic-ease" style="transition-duration: var(--duration-hover);">{spot.name}</p>
                    <p class="text-label-sm text-on-surface-muted mt-1">{spot.area}</p>
                  </div>
                  <div class="md:col-span-8 mt-3 md:mt-0">
                    <p class="text-body-md text-on-surface-variant">{spot.line}</p>
                    <p class="text-label-sm text-on-surface-muted mt-2">{spot.permit}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p class="text-body-md text-on-surface-variant mt-10 reveal">
            Not sure what a spot requires? The <a href="/toronto-photo-permits/" class="underline underline-offset-2 hover:text-primary cubic-ease" style="transition-duration: var(--duration-hover);">Toronto photo permit table</a> lists the requirement, the published fee and who to call for every location above.
          </p>
          <p class="text-body-md text-on-surface-variant mt-4 reveal">
            And if you want to see how a real one unfolds, two are written up on the blog: <a href="/blog/toronto-music-garden-proposal-photography/" class="underline underline-offset-2 hover:text-primary cubic-ease" style="transition-duration: var(--duration-hover);">a surprise proposal at the Toronto Music Garden</a> and <a href="/blog/chateau-des-charmes-proposal-photography/" class="underline underline-offset-2 hover:text-primary cubic-ease" style="transition-duration: var(--duration-hover);">a vineyard proposal at Chateau des Charmes</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ GOOD TO KNOW ═══ -->
  <section class="section-frame bg-background" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="text-center mb-16 reveal">
        <p class="text-label-md text-on-surface-muted mb-4 eyebrow-rule eyebrow-rule-center">Before You Book</p>
        <h2 class="section-title mx-auto">Good to <em>know.</em></h2>
      </div>

      <div class="good-to-know-grid">
        <div class="good-to-know-item reveal">
          <p class="text-heading-md font-serif italic mb-3">Only you know I am there</p>
          <p class="text-body-md text-on-surface-variant">You are the only person I message on the day. If friends or family are hiding nearby, tell me and I will work out where to put them so they stay out of frame until you want them in it.</p>
        </div>
        <div class="good-to-know-item reveal stagger-1">
          <p class="text-heading-md font-serif italic mb-3">Next day film photos</p>
          <p class="text-body-md text-on-surface-variant">The Fujifilm film simulation set lands the next day, so you can send your parents a photo before you have finished telling them the story. The rest follow fully edited.</p>
        </div>
        <div class="good-to-know-item reveal stagger-2">
          <p class="text-heading-md font-serif italic mb-3">Help choosing the spot</p>
          <p class="text-body-md text-on-surface-variant">Light first, location second. Tell me the places you are considering and I will tell you which one photographs best at the hour you have in mind.</p>
        </div>
        <div class="good-to-know-item reveal stagger-3">
          <p class="text-heading-md font-serif italic mb-3">GTA travel included</p>
          <p class="text-body-md text-on-surface-variant">Travel within the Greater Toronto Area is typically included. Anything beyond that, I discuss upfront. No surprise fees on the invoice.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial max-w-3xl">
      <div class="text-center mb-12 reveal">
        <h2 class="text-heading-lg font-serif italic">Questions you might have</h2>
      </div>
      <div class="reveal stagger-1">
        <FAQAccordion items={proposalFaq} />
      </div>
    </div>
  </section>

  <PortfolioFinalCTA
    eyebrow="Planning to propose?"
    title="Let's plan where I stand."
    body="Tell me the date and the spot you are thinking about. One hour, around 80 photos, and the first of them in your inbox the next day."
    ctaLabel="Begin Your Journey"
    ctaHref="/contact/?service=proposal#inquiry"
    background="background"
    image={ctaImage}
    imageAlt="Ashley raising the champagne bottle overhead as she and Donald walk out into the vines after the proposal, by AD Photography"
    imageCaption="Begin Your Journey"
  />

  <ContactModal />
  <FloatingPackagesLink />
</BaseLayout>
