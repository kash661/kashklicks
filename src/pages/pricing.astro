---
/**
 * Pricing
 * -------
 * Hallmark · macrostructure: Workbench (stepped configurator, one question per
 * screen with a sticky total rail) · genre: editorial
 * theme: locked (Digital Curator) · enrichment: none (typography only)
 * motion: 2 primitives (step reveal, total opacity)
 * nav/footer: site chrome (BaseLayout)
 * pre-emit critique: P5 H4 E4 S5 R5 V4
 *
 * A guided questionnaire that takes a couple from "what are you planning?" to a
 * priced package and a booked call. It exists to answer the four questions every
 * ad produces, in public, once: what are your packages, what does it cost, what
 * about the locations, do you do video.
 *
 * Design brief: docs/design/pricing-configurator-brief.md (written and audited
 * before any markup, per the roadmap gate).
 *
 * SOURCES OF TRUTH:
 *   1. src/data/packages.json   packages, prices, hours, addOnIds
 *   2. src/data/add-ons.json    the add-on catalogue, units and prices
 *   3. src/data/pricing-flow.json  the branch questions, editable without code
 *   4. src/data/locations.json  permit fees, shown at cost
 *
 * The editorial landing pages deliberately hide pricing. This page is the
 * separate destination people arrive at when they are ready to configure.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Configurator from '../components/pricing/Configurator.astro';
import packagesData from '../data/packages.json';
import site from '../data/site.json';
import { basePrice } from '../lib/addons';

const packages = packagesData as Array<Record<string, any>>;
const businessRef = { '@id': `${site.url}/#business` };

const offerCatalog = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Photography Packages and Add Ons',
  description:
    'Wedding, pre wedding, civil ceremony, proposal, celebration and headshot photography packages by AD Photography in Toronto, with every add on priced.',
  url: `${site.url}/pricing`,
  offeredBy: businessRef,
  itemListElement: packages
    .filter((p) => basePrice(p) !== null && !p.priceIsRate)
    .map((p) => ({
      '@type': 'Offer',
      name: p.name,
      description: p.description,
      price: basePrice(p),
      priceCurrency: p.currency,
      availability: 'https://schema.org/InStock',
      seller: businessRef,
    })),
};
---

<BaseLayout
  title="Photography Pricing, Toronto | AD Photography"
  description="Build your package and see the price as you go. Wedding, pre wedding, civil ceremony, proposal, celebration and headshot pricing for Toronto and the GTA, with every add on listed."
  canonicalUrl={`${site.url}/pricing/`}
  jsonLd={offerCatalog}
  chrome={false}
>
  <!-- flatpickr · lazy-loaded off the critical path, copied from
       free-engagement-session-toronto.astro. The date field stays a text input
       on purpose: iOS Safari's native picker submitted today's date on "Done",
       which is the bug the contact form's free-text date was written to avoid.
       allowInput is on so "not sure yet" is still a valid answer. -->
  <script is:inline>
    (function () {
      var FP_CSS = 'https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css';
      var FP_JS  = 'https://cdn.jsdelivr.net/npm/flatpickr@4.6.13';
      var loaded = false;
      function load() {
        if (loaded) return; loaded = true;
        var l = document.createElement('link');
        l.rel = 'stylesheet'; l.href = FP_CSS;
        document.head.appendChild(l);
        var s = document.createElement('script');
        s.src = FP_JS; s.async = true;
        document.head.appendChild(s);
      }
      var onIdle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 1200); };
      onIdle(load);
      document.addEventListener('focusin', function (e) {
        var t = e.target;
        if (t && t.matches && t.matches('[data-cfg-date]')) load();
      }, { passive: true });
    })();
  </script>
  <style is:global>
    .flatpickr-calendar {
      border-radius: 0 !important;
      border: 1px solid var(--color-surface-container, #e4e2e1) !important;
      box-shadow: 0 8px 32px rgba(26, 26, 24, 0.08) !important;
      font-family: var(--font-sans, 'Inter', system-ui, sans-serif) !important;
      background: #ffffff !important;
    }
    .flatpickr-day,
    .flatpickr-day.today,
    .flatpickr-day.selected { border-radius: 0 !important; }
    .flatpickr-day.selected,
    .flatpickr-day.selected:hover {
      background: #1a1a18 !important;
      border-color: #1a1a18 !important;
      color: #faf9f6 !important;
    }
    .flatpickr-day.today { border-color: #5f5e5e !important; }
    .flatpickr-day:hover { background: #f4f4f0 !important; }
    .flatpickr-months .flatpickr-month,
    .flatpickr-weekdays { background: #ffffff !important; color: #1a1a18 !important; }
    .flatpickr-current-month .flatpickr-monthDropdown-months,
    .flatpickr-current-month input.cur-year { color: #1a1a18 !important; font-weight: 500 !important; }
    .flatpickr-weekday {
      color: #5c605c !important; font-weight: 500 !important;
      text-transform: uppercase !important; letter-spacing: 0.08em !important;
      font-size: 0.6875rem !important;
    }
  </style>

  {/* The h1 stays for search and screen readers, but it is not on screen:
      the flow is the page, and a headline above it is a distraction. Each
      step's own question carries the visual hierarchy. */}
  <h1 class="cfg-h1">Photography pricing in Toronto. Build your package.</h1>
  <Configurator />

  <noscript>
    <section class="pricing-noscript">
      <div class="container-editorial">
        <p class="text-body-lg">
          Everything above is listed in full without needing scripts. If you would rather just
          talk it through, <a href="/contact/">send me a note</a> and I will come back to you.
        </p>
      </div>
    </section>
  </noscript>
</BaseLayout>

<style>
  .cfg-h1 {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .pricing-noscript { padding-block: var(--spacing-block); }
  :global(html), :global(body) { overflow-x: clip; }
  /* The flow owns the viewport. Only the step body scrolls, never the page.
     Relaxed when scripts are off, so the static price list stays readable. */
  :global(body:has(.cfg--shell)) { overflow: hidden; }
</style>

<script>
  import { initConfigurator } from '../scripts/configurator';
  initConfigurator();
  document.addEventListener('astro:after-swap', () => initConfigurator());
</script>
