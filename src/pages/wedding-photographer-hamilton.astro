---
/*
 * Hallmark · system-managed (defers to .claude/CLAUDE.md "Digital Curator")
 * page: Hamilton wedding photographer (city landing) · sibling of services/wedding.astro
 * pre-emit critique: P5 H4 E4 S5 R4 V4 — composition mirrors the service-page family by design
 * honest-copy: hero quote is the REAL Roxanne + Justin pullQuote from portfolio.json
 * no fabricated metrics/testimonials · no em/en dashes · tokens + components reused
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import PortfolioFinalCTA from '../components/global/PortfolioFinalCTA.astro';
import { Image } from 'astro:assets';
import site from '../data/site.json';

import heroImage from '../assets/images/portfolio/roxanne-justin/40.jpg';
import realWeddingImage from '../assets/images/portfolio/roxanne-justin/21.jpg';
import preWeddingImage from '../assets/images/portfolio/vikrant-sahib/06.jpg';

const hamiltonVenues = [
  { name: 'Dundurn Castle', slug: 'dundurn-castle', note: 'An 1830s Italianate villa with a tree-lined allée and a columned portico. The grandest formal backdrop in the city.' },
  { name: "St. Patrick's Parish", slug: 'st-patricks-parish-hamilton', note: 'Stone Gothic Revival on King Street East, with a painted starry vault and a rose window that floods the aisle with afternoon light.' },
  { name: 'Royal Botanical Gardens', slug: 'royal-botanical-gardens', note: "Canada's largest botanical garden, on the Burlington and Hamilton border. Lilac dell, formal beds, and a year-round greenhouse." },
  { name: 'Bayfront Park', slug: 'bayfront-park', note: 'Open waterfront on Hamilton Harbour. Wind off the lake, big sky, and the Escarpment behind you.' },
  { name: 'Dundas Peak', slug: 'dundas-peak', note: 'The Escarpment lookout above Spencer Gorge. A cinematic cliff-edge view that rewards a timed permit and an early start.' },
  { name: "Webster's Falls", slug: 'websters-falls', note: 'A classic Dundas waterfall framed by a stone bridge and forest. Lush in summer, dramatic after rain.' },
  { name: 'Art Gallery of Hamilton', slug: 'art-gallery-hamilton', note: 'Clean modernist lines downtown and covered architecture, a weather-proof option right in the core.' },
];

const hamiltonFaq = [
  { question: 'Do you travel to Hamilton for weddings?', answer: 'Yes. Hamilton is a regular part of my calendar, and travel to the city is built into every wedding collection. There is no separate travel fee for Hamilton, Dundas, or the surrounding area.' },
  { question: 'What are the best wedding venues in Hamilton?', answer: "It depends on the day you want. St. Patrick's Parish for a traditional ceremony, Dundurn Castle for grand formal portraits, Bayfront Park and the Royal Botanical Gardens for nature, and Dundas Peak or Webster's Falls for couples who want the Escarpment. There are full location guides for each one above." },
  { question: 'Do Hamilton venues need a photography permit?', answer: 'Some do. Dundurn Castle and Dundas Peak both require booking and a permit, and the Conservation Authority caps numbers at the Peak. I help sort the permits as part of planning so nothing gets missed on the day.' },
  { question: 'How much is a wedding photographer in Hamilton?', answer: 'Wedding collections start at $1,400 for focused coverage and scale to full-day storytelling at $3,800. Hamilton is priced exactly like Toronto, with travel to the city included. The full breakdown is on the wedding photography page.' },
  { question: 'Do you photograph Escarpment elopements and small ceremonies?', answer: "Yes. Dundas Peak, Webster's Falls, and the Spencer Gorge area are some of my favourite spots for intimate ceremonies and elopements. A civil ceremony or a small wedding works beautifully out here." },
  { question: 'Can you cover a multi-venue Hamilton day?', answer: "Absolutely. Roxanne and Justin moved from St. Patrick's to Hamilton Harbour to Dundurn Castle, three locations about ten minutes apart, in a single afternoon. Hamilton makes that kind of day easy, and I plan the timeline around the light." },
];

const businessRef = { '@id': `${site.url}/#business` };

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Hamilton Wedding Photography',
  description: 'Wedding photography in Hamilton, Ontario by AD Photography. Coverage at Dundurn Castle, St. Patrick’s Parish, the Royal Botanical Gardens, and the Escarpment, with travel from Toronto included.',
  provider: businessRef,
  areaServed: {
    '@type': 'City',
    name: 'Hamilton',
    address: { '@type': 'PostalAddress', addressRegion: 'ON', addressCountry: 'CA' },
  },
  serviceType: 'Wedding Photography',
  image: `${site.url}/og-default.jpg`,
  url: `${site.url}/wedding-photographer-hamilton/`,
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hamiltonFaq.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
};

const jsonLd = [serviceSchema, faqPageSchema];
---

<BaseLayout
  title="Hamilton Wedding Photographer"
  description="Hamilton wedding photographer covering Dundurn Castle, St. Patrick's Parish, the Royal Botanical Gardens, and the Escarpment. Real Hamilton weddings, transparent pricing, travel included."
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs (visually hidden, still crawled for search snippets) -->
  <div class="sr-only">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Hamilton Wedding Photographer', href: '/wedding-photographer-hamilton/' },
    ]} />
  </div>

  <!-- ═══ HERO: real Hamilton couple quote + portrait ═══ -->
  <section style="padding-top: var(--spacing-block); padding-bottom: var(--spacing-block);">
    <div class="container-editorial">
      <div class="grid-editorial items-center" style="min-height: 80svh;">
        <div class="col-span-12 md:col-span-5 reveal order-2 md:order-1">
          <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">Hamilton · Wedding Photography</p>
          <blockquote class="text-display-md" style="max-width: 22ch;">
            "We kept coming back to the silhouette through the church doorway. That is the moment we walked out married, and somehow they caught it."
          </blockquote>
          <p class="text-label-md text-on-surface-variant mt-8">Roxanne &amp; Justin</p>
          <p class="text-label-sm text-on-surface-muted">St. Patrick's Parish &amp; Dundurn Castle, Hamilton</p>
          <div class="mt-8 flex items-center gap-3 flex-wrap">
            <Button href="#investment" variant="primary">See Investment</Button>
            <Button href="/contact/?location=hamilton" variant="secondary">Start the Conversation</Button>
          </div>
        </div>
        <figure class="col-span-12 md:col-span-6 md:col-start-7 reveal-right stagger-2 order-1 md:order-2 mb-[var(--spacing-element)] md:mb-0">
          <div class="aspect-[3/4] overflow-hidden hover-zoom">
            <Image
              src={heroImage}
              alt="Roxanne and Justin during their Hamilton wedding portraits at Dundurn Castle, by AD Photography"
              widths={[640, 960, 1280]}
              sizes="(max-width: 768px) 100vw, 50vw"
              quality={75}
              format="avif"
              class="w-full h-full object-cover parallax-img"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="gallery-plaque">
            <div class="gallery-plaque__line">
              <span class="gallery-plaque__plate">Wedding</span>
              <span class="gallery-plaque__rule" aria-hidden="true"></span>
              <span class="gallery-plaque__meta">Dundurn Castle, Hamilton</span>
            </div>
            <p class="gallery-plaque__title">Roxanne <em>&amp;</em> Justin</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ═══ WHY HAMILTON (carries the H1) ═══ -->
  <section class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-center">
        <div class="col-span-12 lg:col-span-5 aspect-[3/4] overflow-hidden reveal-left hover-zoom order-2 lg:order-1 mt-10 lg:mt-0">
          <Image
            src={realWeddingImage}
            alt="Roxanne and Justin on the church steps of St. Patrick's Parish in Hamilton, family cheering, by AD Photography"
            widths={[400, 600, 800]}
            sizes="(max-width: 1024px) 100vw, 42vw"
            class="w-full h-full object-cover parallax-img"
            loading="lazy"
          />
        </div>
        <div class="col-span-12 lg:col-span-6 lg:col-start-7 reveal stagger-2 order-1 lg:order-2">
          <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">Why Hamilton</p>
          <h1 class="section-title char-reveal">Wedding photographer in <em>Hamilton.</em></h1>
          <p class="section-deck text-on-surface-variant mt-8 measure-wide">
            Hamilton is built for a wedding day with range. Stone Gothic churches downtown, an Italianate castle on the hill, waterfront on the harbour, and the Escarpment with its waterfalls and lookouts, all within a short drive of each other.
          </p>
          <p class="text-body-md text-on-surface-variant mt-5 measure-wide">
            I shoot the city candidly and cinematically, with light prompting rather than long posed set-ups. The light here rewards planning. Late afternoon warms the King Street churches, the lake throws soft open shade at Bayfront, and the Dundas gorge goes golden right before close. I build the timeline around those windows so the day feels unhurried and the photos do the rest.
          </p>
          <p class="text-body-md text-on-surface-variant mt-5 measure-wide">
            Based in Toronto and out in Hamilton often, I cover the city as a regular part of my calendar, with travel included.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HAMILTON VENUES (content leverage + internal links) ═══ -->
  <section class="section-frame bg-background" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-end" style="margin-bottom: var(--spacing-block);">
        <div class="col-span-12 md:col-span-7">
          <p class="text-label-md text-on-surface-muted reveal eyebrow-rule mb-6">The Venues</p>
          <h2 class="section-title reveal stagger-1">Where I shoot in <em>Hamilton.</em></h2>
        </div>
        <div class="col-span-12 md:col-span-5 md:col-start-8 mt-6 md:mt-0">
          <p class="section-deck text-on-surface-variant reveal stagger-2 measure-wide">
            Seven venues I know well, each with a full location guide on parking, permits, and the best light.
          </p>
        </div>
      </div>

      <ul class="venue-list reveal stagger-2">
        {hamiltonVenues.map((v) => (
          <li class="venue-row">
            <a href={`/location-guide/${v.slug}/`} class="venue-row__name text-heading-md font-serif cubic-ease" style="transition-duration: var(--duration-hover);">
              {v.name}
            </a>
            <p class="venue-row__note text-body-md text-on-surface-variant measure-wide">{v.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ REAL HAMILTON WEDDING (proof) ═══ -->
  <section class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="reveal" style="max-width: 60ch;">
        <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">A Real Hamilton Wedding</p>
        <h2 class="section-title">From stone to <em>light.</em></h2>
        <p class="section-deck text-on-surface-variant mt-8">
          Roxanne and Justin's day moved from the rose window at St. Patrick's, out to the wind off Hamilton Harbour, and up the tree-lined allée at Dundurn Castle. Three venues, ten minutes apart, one afternoon.
        </p>
        <div class="mt-8 flex items-center gap-3 flex-wrap">
          <Button href="/blog/hamilton-wedding-st-patricks-dundurn-roxanne-justin/" variant="primary">Read their day</Button>
          <Button href="/portfolio/roxanne-justin/" variant="secondary">See the gallery</Button>
        </div>
      </div>

      <div class="grid-editorial items-center mt-12">
        <div class="col-span-12 lg:col-span-7 aspect-[16/10] overflow-hidden reveal hover-zoom">
          <Image
            src={preWeddingImage}
            alt="Vikrant and Sahib pre-wedding portraits at Dundurn Castle, Hamilton, by AD Photography"
            widths={[640, 960, 1280]}
            sizes="(max-width: 1024px) 100vw, 58vw"
            class="w-full h-full object-cover parallax-img"
            loading="lazy"
          />
        </div>
        <div class="col-span-12 lg:col-span-4 lg:col-start-9 reveal stagger-2 mt-8 lg:mt-0">
          <p class="text-quote italic text-on-surface-variant">Engagement sessions too.</p>
          <p class="text-body-md text-on-surface-variant mt-4 measure-wide">
            Vikrant and Sahib's pre-wedding ran through Dundurn Castle and Burlington Village. See more in the <a href="/portfolio/vikrant-sahib/" class="underline-link">pre-wedding gallery</a>, or read the <a href="/blog/dundurn-castle-wedding-photographer-guide/" class="underline-link">Dundurn Castle photographer's guide</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ INVESTMENT (condensed, funnels to canonical service page) ═══ -->
  <section id="investment" class="section-frame bg-background" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial">
      <div class="grid-editorial items-center">
        <div class="col-span-12 lg:col-span-6 reveal">
          <p class="text-label-md text-on-surface-muted mb-6 eyebrow-rule">Investment</p>
          <h2 class="section-title">Hamilton wedding <em>collections.</em></h2>
        </div>
        <div class="col-span-12 lg:col-span-5 lg:col-start-8 reveal stagger-2 mt-6 lg:mt-0">
          <p class="section-deck text-on-surface-variant measure-wide">
            Wedding collections start at $1,400 for focused coverage and scale to full-day storytelling at $3,800. Hamilton is priced exactly like Toronto, with travel to the city included. Every collection includes a pre-wedding consultation and a private online gallery.
          </p>
          <div class="mt-8">
            <Button href="/services/wedding/" variant="primary">See the full packages</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ (Hamilton-specific, FAQPage schema) ═══ -->
  <section class="section-frame bg-surface-dim" style="padding: var(--spacing-section) 0;">
    <div class="container-editorial max-w-3xl">
      <div class="text-center mb-12 reveal">
        <h2 class="text-heading-lg font-serif italic">Hamilton questions</h2>
      </div>
      <div class="reveal stagger-1">
        <FAQAccordion items={hamiltonFaq} />
      </div>
    </div>
  </section>

  <PortfolioFinalCTA
    title="Let's plan your Hamilton day."
    body="Book a free consultation. No pressure, just a conversation about your venues, your timeline, and the light."
    ctaLabel="Begin Your Journey"
    ctaHref="/contact/?location=hamilton"
    background="background"
    image={heroImage}
    imageAlt="Hamilton wedding couple portrait at Dundurn Castle by AD Photography"
    imageCaption="Begin Your Journey"
  />
</BaseLayout>

<style>
  /* Venue list: editorial two-column, separated by space not borders (Digital Curator rule). */
  .venue-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-block);
  }
  @media (min-width: 768px) {
    .venue-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--spacing-block);
    }
  }
  .venue-row__name {
    display: inline-block;
    color: var(--color-on-surface);
  }
  .venue-row__name:hover {
    color: var(--color-primary);
  }
  .venue-row__note {
    margin-top: 0.5rem;
  }
  .underline-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--color-on-surface);
    transition: color var(--duration-hover) var(--ease-gallery);
  }
  .underline-link:hover {
    color: var(--color-primary);
  }
</style>
