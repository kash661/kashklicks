    {
      "id": "story",
      "numeral": "II",
      "title": "Your story",
      "fields": [
        {
          "name": "story_how_met",
          "label": "How did you two meet?",
          "kind": "textarea",
          "required": true,
          "rows": 5,
          "help": "The real version. Funny, awkward, sweet, all of it. This often becomes the spine of your film."
        },
        {
          "name": "story_three_words",
          "label": "Three words for the two of you",
          "kind": "text",
          "placeholder": "e.g. loud, loyal, always late"
        },
        {
          "name": "story_about",
          "label": "What is it like being together?",
          "kind": "textarea",
          "rows": 4,
          "help": "A normal Tuesday, the way you talk to each other, who makes the plans."
        },
        {
          "name": "story_love_doing",
          "label": "What do you love doing together?",
          "kind": "textarea",
          "rows": 3
        },
        {
          "name": "story_inside_jokes",
          "label": "Inside jokes, pet names or little rituals",
          "kind": "textarea",
          "rows": 3,
          "extra": true
        },
        {
          "name": "story_shyer",
          "label": "Who is shyer in front of a camera?",
          "kind": "text",
          "extra": true,
          "placeholder": "e.g. Arjun, but he warms up fast"
        },
        {
          "name": "story_meaningful",
          "label": "A place, date or object that means a lot to you",
          "kind": "textarea",
          "rows": 3,
          "extra": true,
          "help": "A ring box, a first date spot, a song from a road trip. I love building a moment around these."
        }
      ],
      "extraLabel": "A little more, if you like",
      "extraHint": "(optional, these give the film its small moments)"
