---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'ghost-on-dark';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const base = 'inline-flex items-center justify-center whitespace-nowrap text-label-md cubic-ease focus-visible:outline-2 focus-visible:outline-offset-2';

const variants = {
  primary: 'bg-primary text-on-dark hover:bg-primary-hover px-8 py-4',
  secondary: 'border border-ghost text-primary hover:text-primary-hover px-6 py-3',
  ghost: 'text-on-surface-variant hover:text-on-surface px-4 py-2',
  'ghost-on-dark': 'border border-on-dark/70 text-on-dark hover:bg-on-dark hover:text-on-surface px-9 py-3.5',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button class={classes}>
    <slot />
  </button>
)}

<style>
  a, button {
    transition:
      transform 120ms ease-out,
      background-color var(--duration-hover) var(--ease-gallery),
      color var(--duration-hover) var(--ease-gallery),
      border-color var(--duration-hover) var(--ease-gallery),
      opacity var(--duration-hover) var(--ease-gallery);
  }

  a:active, button:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    a:active, button:active {
      transform: none;
    }
  }
</style>
