---
interface FilterMeta {
  film?: boolean;
  sale?: boolean;
  custom?: boolean;
  price?: number;
}

interface Props {
  name: string;
  price: number | null;
  salePrice?: number;
  description: string;
  highlights: string[];
  popular?: boolean;
  featured?: boolean;
  custom?: boolean;
  id: string;
  ordinal?: number;
  service?: string;
  ctaLabel?: string;
  /* Optional custom badge text. Takes priority over the derived
     Most Popular / Limited Offer badges. */
  badge?: string;
  filterMeta?: FilterMeta;
  /* Opt-in: render as a mobile tap-to-open accordion row (pre-wedding page).
     Off by default, so every other page renders byte-identical to before. */
  accordion?: boolean;
  /* Optional explicit tag for the collapsed row (e.g. "Up to 6 hours").
     Falls back to a Photos/Film label derived from filterMeta. */
  accordionTag?: string;
}

const {
  name,
  price,
  salePrice,
  description,
  highlights,
  popular,
  featured,
  custom = false,
  id,
  ordinal,
  service,
  ctaLabel = 'Enquire',
  badge,
  filterMeta,
  accordion = false,
  accordionTag,
} = Astro.props;

const romans = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const plateLabel = ordinal != null ? `Package ${romans[ordinal] ?? ordinal + 1}` : 'Package';

// Lift this tier visually — user-flagged popular, on-sale, or explicitly featured.
const isFeatured = !!(featured ?? popular);

// Add-ons live in the shared PackageAddOns section. Cards stay focused on
// "what you get" at this tier.
const isAddOn = (item: string) => item.includes('+$') || item.includes('available');
const includedItems = highlights.filter((item) => !isAddOn(item));

const hasSale = !!salePrice;
const displayPrice = hasSale ? salePrice : price;

// Mobile accordion: the compact tag shown on the collapsed row. Pages may pass
// an explicit `accordionTag` (e.g. coverage duration); otherwise it derives a
// Photos/Film label from filterMeta.
const accordionTagLabel = accordionTag ?? (filterMeta?.film ? 'Film' : 'Photos');
---

<article
  id={id}
  class:list={['pricing-card', filterMeta ? 'package-card' : '', accordion ? 'pricing-card--accordion' : '']}
  data-accordion={accordion ? '' : undefined}
  data-featured={isFeatured ? 'true' : undefined}
  data-film={filterMeta ? (filterMeta.film ? 'true' : 'false') : undefined}
  data-sale={filterMeta ? (filterMeta.sale ? 'true' : 'false') : undefined}
  data-custom={filterMeta ? (filterMeta.custom ? 'true' : 'false') : undefined}
  data-price={filterMeta?.price}
>
  {badge && (
    <span class="pricing-card__badge">{badge}</span>
  )}
  {!badge && popular && !hasSale && (
    <span class="pricing-card__badge">Most Popular</span>
  )}
  {!badge && hasSale && (
    <span class="pricing-card__badge">Limited Offer</span>
  )}

  <header class="pricing-card__head">
    <p class="pricing-card__eyebrow">
      <span class="pricing-card__eyebrow-label">{plateLabel}</span>
    </p>
    <h3 class="pricing-card__name">{name}</h3>
    <p class="pricing-card__deck">{description}</p>
    {accordion && (
      <p class="pricing-card__summary">
        {custom ? (
          <span class="pricing-card__summary-price">Custom</span>
        ) : (
          <Fragment>
            <span class="pricing-card__summary-tag">{accordionTagLabel}</span>
            <span class="pricing-card__summary-sep" aria-hidden="true">&middot;</span>
            <span class="pricing-card__summary-price">
              {hasSale ? (
                <Fragment>${displayPrice?.toLocaleString()} <s>${price?.toLocaleString()}</s></Fragment>
              ) : (
                <Fragment>from ${displayPrice?.toLocaleString()}</Fragment>
              )}
            </span>
            {badge && <span class="pricing-card__summary-note">{badge}</span>}
          </Fragment>
        )}
      </p>
    )}
    {accordion && <span class="pricing-card__chev" aria-hidden="true">&rsaquo;</span>}
  </header>

  <div class="pricing-card__body-wrap"><div class="pricing-card__body">
  {custom ? (
    <div class="pricing-card__price-block">
      <span class="pricing-card__price-kicker">Investment</span>
      <span class="pricing-card__price"><em>Custom</em></span>
    </div>
  ) : (
    <div class="pricing-card__price-block">
      <span class="pricing-card__price-kicker">Starting at</span>
      <span class="pricing-card__price">
        <span>${displayPrice?.toLocaleString()}</span>
        {hasSale && price && (
          <span class="pricing-card__price-strike">${price.toLocaleString()}</span>
        )}
      </span>
    </div>
  )}

  {includedItems.length > 0 && (
    <div class="pricing-card__included">
      <p class="pricing-card__included-label">What's Included</p>
      <ul class="pricing-card__list">
        {includedItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )}

  {/*
    Native-link fallback: if the modal script fails to bind (JS error earlier
    in the page, slow hydration, etc.) the CTA still navigates to /contact/
    with the package context preserved. The inline form on /contact/ reads
    these URL params and pre-fills event_type + hidden package fields. The
    #inquiry hash scrolls to the form. Modal binding intercepts the click
    via event.preventDefault() when JS is healthy on /services/* pages.
  */}
  <a
    href={`/contact/?${service ? `service=${encodeURIComponent(service)}&` : ''}package=${encodeURIComponent(id)}&package_name=${encodeURIComponent(name)}#inquiry`}
    class="pricing-card__cta"
    data-open-modal="contact-modal"
    data-service={service}
    data-package={id}
    data-package-name={name}
    role="button"
  >
    {ctaLabel}
    <span class="pricing-card__cta-arrow" aria-hidden="true">&rarr;</span>
  </a>
  </div></div>
</article>
