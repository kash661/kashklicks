---
interface Props {
  items: { question: string; answer: string }[];
  defaultOpen?: boolean;
}

const { items, defaultOpen = false } = Astro.props;
---

<div class="faq-accordion">
  {items.map((item, i) => (
    <details class:list={['faq-item', i === 0 && 'faq-item-first']} open={defaultOpen && i === 0}>
      <summary class="faq-summary">
        <h3 class="text-body-lg font-medium pr-8">{item.question}</h3>
        <span class="faq-icon text-on-surface-variant text-2xl shrink-0" aria-hidden="true">+</span>
      </summary>
      <div class="faq-answer">
        <p class="text-body-md text-on-surface-variant" style="padding-top: 8px; max-width: 65ch;">
          {item.answer}
        </p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-item {
    padding: var(--spacing-element) 0;
  }
  .faq-item-first {
    padding-top: 0;
  }

  /* Native <details>/<summary> — works without JS, no pre-hydration dead clicks.
     Strip default disclosure marker + restore our own +/x indicator. */
  .faq-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-align: left;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary::marker { content: ''; }

  .faq-icon {
    display: inline-block;
    transform-origin: center;
    transition: transform var(--duration-hover-ui, var(--duration-hover)) var(--ease-gallery);
  }
  .faq-item[open] > .faq-summary .faq-icon {
    transform: rotate(45deg);
  }

  /* Fade the answer body in on open. Height itself is native (snap), so we
     animate opacity only — keeps the editorial calm without a janky height
     interpolation across browsers. */
  .faq-answer {
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-gallery);
  }
  .faq-item[open] > .faq-answer {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer,
    .faq-icon {
      transition: none;
    }
    .faq-item[open] > .faq-answer { opacity: 1; }
  }
</style>
