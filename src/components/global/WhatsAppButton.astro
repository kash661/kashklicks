---
/* Hallmark · component: floating-action-link (WhatsApp) · genre: editorial · theme: Digital Curator (project tokens)
 * states: default · hover · focus-visible · active · reduced-motion
 *   (loading / error / success / disabled are N/A — this is an external navigation link, not a stateful action)
 * pre-emit critique: P5 H4 E4 S5 R5 V4
 * contrast: on-dark #faf9f6 on surface-dark #2c2824 — pass
 */
import site from '../../data/site.json';

// First-person, warm, no em dashes (per brand voice). Sent from the visitor to Akash.
const prefill = encodeURIComponent(
  "Hi Akash, I came across your website and I'd love to ask about your photography.",
);
const waHref = `https://wa.me/${site.whatsapp}?text=${prefill}`;
---

<a
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-fab"
  aria-label="Message me on WhatsApp"
  title="Message me on WhatsApp"
>
  <svg class="wa-fab__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.2 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 1.67c2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 012.42 5.82c0 4.54-3.7 8.24-8.25 8.24-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 01-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24zm-3.6 4.43c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.43 1.03 2.6.13.17 1.77 2.7 4.3 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.69-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.29-.25-.12-1.48-.73-1.71-.81-.23-.08-.4-.12-.56.13-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.48-1.38-1.73-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43z"
    ></path>
  </svg>
  <span class="wa-fab__label text-label-sm">Message me</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(1rem, 4vw, 2rem);
    bottom: calc(clamp(1rem, 4vw, 2rem) + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 0; /* hard rule: square, never a pill/circle */
    color: var(--color-on-dark, #faf9f6);
    background: var(--color-surface-dark, #2c2824);
    box-shadow: 0 2px 18px rgba(26, 26, 24, 0.22);
    text-decoration: none;
    opacity: 0;
    transform: translateY(8px);
    animation: wa-fab-in 500ms var(--ease-gallery, cubic-bezier(0.22, 1, 0.36, 1)) 700ms forwards;
    transition:
      background-color var(--duration-hover, 500ms) var(--ease-gallery, cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--duration-hover, 500ms) var(--ease-gallery, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .wa-fab:hover {
    background: var(--color-primary, #5f5e5e);
  }
  .wa-fab:active {
    transform: translateY(1px);
  }
  .wa-fab:focus-visible {
    outline: 2px solid var(--color-on-dark, #faf9f6);
    outline-offset: 3px;
  }
  .wa-fab__icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
  }
  .wa-fab__label {
    color: inherit;
    line-height: 1;
  }

  @keyframes wa-fab-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Smaller phones: tighten so it never crowds content or the thumb zone */
  @media (max-width: 480px) {
    .wa-fab {
      padding: 0.7rem 0.85rem;
      gap: 0.4rem;
    }
  }
</style>
