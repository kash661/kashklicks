---
import site from '../../data/site.json';

const year = new Date().getFullYear();
---

<footer role="contentinfo" class="footer-ft5 bg-surface-dark">
  <div class="container-editorial">
    <div class="footer-ft5__inner">

      <p class="footer-ft5__statement text-display-md italic text-on-dark">
        Moments fade.<br />Memories don't.
      </p>

      <span aria-hidden="true" class="footer-ft5__rule"></span>

      <div class="footer-ft5__contact">
        <a
          href={`mailto:${site.email}`}
          class="footer-ft5__link text-body-md text-on-dark"
        >
          {site.email}
        </a>
        <p class="text-body-md text-on-dark-variant">
          {site.location.city}, {site.location.regionCode} · GTA + Canada-wide
        </p>
      </div>

      <nav class="footer-ft5__social" aria-label="Social">
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-ft5__link footer-ft5__social-link text-label-md text-on-dark-variant"
        >
          Instagram
        </a>
        <a
          href={site.social.pinterest}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-ft5__link footer-ft5__social-link text-label-md text-on-dark-variant"
        >
          Pinterest
        </a>
        <a
          href={site.social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-ft5__link footer-ft5__social-link text-label-md text-on-dark-variant"
        >
          YouTube
        </a>
      </nav>

      <div class="footer-ft5__legal">
        <p class="text-label-sm text-on-dark-variant">
          &copy; {year} AD Photography
        </p>
        <p class="footer-ft5__legal-row text-label-sm text-on-dark-variant">
          <a href="/privacy" class="footer-ft5__link">Privacy</a>
          <span aria-hidden="true" class="footer-ft5__legal-sep">·</span>
          <a href="/terms" class="footer-ft5__link">Terms</a>
        </p>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer-ft5 {
    padding-block: var(--spacing-section);
  }

  .footer-ft5__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: 56rem;
  }

  .footer-ft5__statement {
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .footer-ft5__rule {
    display: block;
    width: 96px;
    height: 1px;
    background: color-mix(in srgb, var(--color-on-dark-variant) 60%, transparent);
  }

  .footer-ft5__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-ft5__contact p {
    margin: 0;
  }

  .footer-ft5__social {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 2.75rem);
  }

  .footer-ft5__legal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-ft5__legal p {
    margin: 0;
  }

  .footer-ft5__legal-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-ft5__legal-sep {
    opacity: 0.5;
  }

  .footer-ft5__link {
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
    transition:
      color var(--duration-hover) var(--ease-gallery),
      transform 120ms ease-out;
  }

  .footer-ft5__legal .footer-ft5__link {
    min-height: 0;
    line-height: inherit;
  }

  .footer-ft5__link:hover {
    color: var(--color-on-dark);
  }

  .footer-ft5__link:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-ft5__link {
      transition: color var(--duration-hover) var(--ease-gallery);
    }
    .footer-ft5__link:active {
      transform: none;
    }
  }
</style>
