---
import JsonLd from './JsonLd.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Canonicalize internal hrefs to the trailing-slash form the Worker 301-forces,
// so neither the rendered links nor the BreadcrumbList JSON-LD URLs trigger a
// redirect hop. Leaves external/hash/query/file-extension links untouched.
function withTrailingSlash(href: string): string {
  if (/^https?:\/\//.test(href)) return href;
  const [pathAndQuery, hash] = href.split('#');
  const [path, query] = pathAndQuery.split('?');
  if (query !== undefined) return href; // has a query string — leave as-is
  if (path === '/' || path.endsWith('/') || /\.[^/]+$/.test(path)) return href;
  return hash !== undefined ? `${path}/#${hash}` : `${path}/`;
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(withTrailingSlash(item.href), Astro.site).href,
  })),
};
---

<nav aria-label="Breadcrumb" class="text-label-sm text-on-surface-muted mb-8">
  <ol class="flex items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span class="text-on-surface-muted" aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span class="text-on-surface-variant" aria-current="page">{item.label}</span>
        ) : (
          <a href={withTrailingSlash(item.href)} class="hover:text-on-surface cubic-ease" style="transition-duration: var(--duration-hover);">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<JsonLd schema={schema} />
