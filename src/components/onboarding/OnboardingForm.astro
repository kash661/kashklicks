---
// The client shoot brief. Iterates src/data/onboarding-fields.json: nine
// roman-numeral sections, optional questions folded into a native <details>
// per section. The page script (src/scripts/onboarding.ts) serializes the
// answers into payload_json, autosaves a draft, and posts to /r/onboarding.
import schemaJson from '../../data/onboarding-fields.json';
import type { Schema } from '../../lib/onboarding';
import OnboardingField from './OnboardingField.astro';

const schema = schemaJson as unknown as Schema;

const steps = [
  { numeral: 'I', body: 'I read your brief within 2 days.' },
  { numeral: 'II', body: 'I draft your storyline and run of show, then share the doc for your comments.' },
  { numeral: 'III', body: 'We lock it in a few days before the shoot.' },
];
---

<div class="onb" data-onb-root>
  <div class="container-editorial">
    <div class="grid-editorial onb-layout">
      <aside class="onb-jump" aria-label="Brief sections">
        <div class="onb-jump__inner">
          <p class="onb-jump__title">Your brief</p>
          <ol class="onb-jump__list">
            {schema.sections.map((s) => (
              <li>
                <a href={`#onb-s-${s.id}`} class="onb-jump__link" data-onb-jump={s.id}>
                  <span class="onb-jump__num">{s.numeral}</span>
                  <span class="onb-jump__label">{s.title}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="onb-saved" data-onb-saved aria-live="polite"></p>
        </div>
      </aside>

      <div class="onb-main">
        <form
          id="onb-form"
          class="onb-form"
          action={schema.meta.endpoint}
          method="POST"
          novalidate
          data-clarity-mask="true"
        >
          <div class="onb-honeypot" aria-hidden="true">
            <label for="onb-gotcha">Leave this empty</label>
            <input type="text" id="onb-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="booking_id" id="onb-booking-id" value="" />
          <input type="hidden" name="idempotency_key" id="onb-idempotency-key" value="" />
          <input type="hidden" name="payload_json" id="onb-payload-json" value="" />
          <input type="hidden" name="source" value="onboarding" />

          {schema.sections.map((section) => {
            const main = section.fields.filter((f) => !f.extra);
            const extras = section.fields.filter((f) => f.extra);
            return (
              <fieldset class="form-section onb-section" id={`onb-s-${section.id}`} data-onb-section={section.id}>
                <legend class="form-section__legend">
                  <span class="form-section__number">{section.numeral}</span>
                  <span class="form-section__title">{section.title}</span>
                </legend>
                <div class="onb-grid">
                  {main.map((field) => <OnboardingField field={field} schema={schema} />)}
                </div>
                {extras.length > 0 && (
                  <details class="form-extras onb-extras" data-onb-extras>
                    <summary class="form-extras__summary">
                      <span class="form-extras__label">{section.extraLabel ?? 'A few more'}</span>
                      {section.extraHint && <span class="form-extras__hint">{section.extraHint}</span>}
                      <span class="form-extras__icon" aria-hidden="true">+</span>
                    </summary>
                    <div class="form-extras__body">
                      <div class="onb-grid">
                        {extras.map((field) => <OnboardingField field={field} schema={schema} />)}
                      </div>
                    </div>
                  </details>
                )}
              </fieldset>
            );
          })}

          <div class="form-submit onb-submit">
            <div class="form-submit__break"></div>
            <p class="onb-submit__problem" data-onb-problem role="alert" hidden>
              A few answers need a look. I have marked them above.
            </p>
            <button type="submit" class="form-submit__button" data-onb-submit>
              <span data-onb-submit-label>Send my brief</span>
              <span class="form-submit__arrow" aria-hidden="true">&rarr;</span>
            </button>
            <p class="form-submit__note">
              <span class="form-field__required" aria-hidden="true">*</span> required. Everything else helps, so share what you can.
            </p>
            <p class="onb-saved onb-saved--inline" data-onb-saved aria-live="polite"></p>
          </div>

          <div class="onb-error" data-onb-error role="alert" hidden>
            <p class="onb-error__title">Your brief did not send</p>
            <p class="onb-error__body">
              Nothing is lost, your answers are saved on this device. Please try again in a minute, or email me at
              <a href="mailto:info@kashklicks.ca">info@kashklicks.ca</a>.
            </p>
          </div>
        </form>

        <section class="onb-done" id="onb-done" data-onb-done hidden tabindex="-1" aria-labelledby="onb-done-title">
          <h2 class="text-display-md onb-done__title" id="onb-done-title">
            Thank you, <em data-onb-done-names>both of you.</em>
          </h2>
          <p class="text-body-lg onb-done__lead">Your brief is with me. Here is what happens next.</p>
          <dl class="onb-next">
            {steps.map((step) => (
              <div class="onb-next__step">
                <dt class="onb-next__numeral">{step.numeral}</dt>
                <dd class="onb-next__body">{step.body}</dd>
              </div>
            ))}
          </dl>
          <p class="onb-done__meta">
            Remembered something later? Reply to my email, or send it on Instagram. I will add it to your brief.
          </p>
        </section>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Everything is prefixed .onb- and lives in one global block so styles
     reach markup from the child components and states the script toggles. */
  .onb [hidden] { display: none !important; }

  .onb {
    background: var(--color-surface-dim);
    padding: var(--spacing-section) 0;
  }

  .onb-layout { align-items: start; }

  .onb-jump { display: none; }
  .onb-main { grid-column: 1 / -1; min-width: 0; }

  @media (min-width: 1024px) {
    .onb-jump {
      display: block;
      grid-column: 1 / span 3;
      position: sticky;
      top: 7rem;
      align-self: start;
    }
    .onb-main { grid-column: 5 / span 8; }
  }

  .onb-jump__title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-on-surface-muted);
    margin-bottom: 1.25rem;
  }
  .onb-jump__list { display: flex; flex-direction: column; gap: 0.125rem; }
  .onb-jump__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.4rem 0;
    color: var(--color-on-surface-variant);
    transition: color var(--duration-slow) var(--ease-gallery);
  }
  .onb-jump__link:hover,
  .onb-jump__link:focus-visible,
  .onb-jump__link[aria-current='true'] { color: var(--color-on-surface); }
  .onb-jump__link:focus-visible { outline: 2px solid var(--color-on-surface); outline-offset: 4px; }
  .onb-jump__num {
    flex: 0 0 2.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.125rem;
  }
  .onb-jump__label { font-family: var(--font-sans); font-size: 0.875rem; }
  .onb-jump__link[aria-current='true'] .onb-jump__label { text-decoration: underline; text-underline-offset: 0.3em; }

  .onb-saved {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-on-surface-muted);
    min-height: 1.5em;
  }
  .onb-saved--inline { margin-top: 0.75rem; }

  .onb-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; opacity: 0; }

  .onb-section { scroll-margin-top: 6.5rem; }
  .onb-section + .onb-section { margin-top: clamp(4rem, 8vw, 6rem); }

  .onb-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 1.5rem;
  }
  @media (min-width: 640px) {
    .onb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .onb-full { grid-column: 1 / -1; }
    .onb-half { grid-column: span 1; }
  }

  .onb-group { border: 0; padding: 0; margin: 0; min-width: 0; }
  .onb-group > legend { padding: 0; }

  /* Choice chips: radios and checkboxes as large, square tap targets. */
  .onb-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .onb-chip { position: relative; display: inline-flex; }
  .onb-chip input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .onb-chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-on-surface-variant) 28%, transparent);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--color-on-surface);
    transition: background-color var(--duration-slow) var(--ease-gallery),
                color var(--duration-slow) var(--ease-gallery),
                box-shadow var(--duration-slow) var(--ease-gallery);
  }
  .onb-chip:hover span { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-on-surface-variant) 60%, transparent); }
  .onb-chip input:checked + span {
    background: var(--color-on-surface);
    color: var(--color-on-dark);
    box-shadow: inset 0 0 0 1px var(--color-on-surface);
  }
  .onb-chip input:focus-visible + span { outline: 2px solid var(--color-on-surface); outline-offset: 2px; }
  .onb-chip input:disabled { cursor: not-allowed; }
  .onb-chip input:disabled + span { opacity: 0.4; }
  .onb-chip--small span { min-height: 2.5rem; padding: 0.375rem 0.875rem; font-size: 0.875rem; }
  .onb-group[data-invalid] .onb-chip span { box-shadow: inset 0 0 0 1px var(--color-error); }

  /* Single tick box (voiceover, consent). */
  .onb-tick { display: flex; align-items: flex-start; gap: 0.875rem; cursor: pointer; }
  .onb-tick input {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: 0.1rem 0 0;
    border-radius: 0;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-on-surface-variant) 45%, transparent);
    display: grid;
    place-content: center;
    cursor: pointer;
    transition: background-color var(--duration-slow) var(--ease-gallery);
  }
  .onb-tick input::after {
    content: '';
    width: 0.4rem;
    height: 0.75rem;
    border: solid var(--color-on-dark);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-gallery);
  }
  .onb-tick input:checked { background: var(--color-on-surface); }
  .onb-tick input:checked::after { opacity: 1; }
  .onb-tick input:focus-visible { outline: 2px solid var(--color-on-surface); outline-offset: 3px; }
  .onb-tick input[aria-invalid='true'] { box-shadow: inset 0 0 0 1px var(--color-error); }
  .onb-tick__text { font-family: var(--font-sans); font-size: 1rem; line-height: 1.55; color: var(--color-on-surface); }
  .onb-privacy {
    margin: 0.75rem 0 0 2.375rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }
  .onb-privacy a { text-decoration: underline; text-underline-offset: 0.2em; }

  .onb-warn {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
  }

  .onb-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-on-surface);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    transition: color var(--duration-slow) var(--ease-gallery);
  }
  .onb-link-btn:hover { color: var(--color-primary-hover); }
  .onb-link-btn:focus-visible { outline: 2px solid var(--color-on-surface); outline-offset: 3px; }

  /* Optional blocks: same look as the contact form's extras. */
  .onb-extras { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(175, 179, 174, 0.25); }
  .onb .form-extras__summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    min-height: 2.75rem;
  }
  .onb .form-extras__summary::-webkit-details-marker { display: none; }
  .onb .form-extras__summary::marker { content: ''; }
  .onb .form-extras__summary:focus-visible { outline: 2px solid var(--color-on-surface); outline-offset: 4px; }
  .onb .form-extras__label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-on-surface);
  }
  .onb .form-extras__hint { font-family: var(--font-sans); font-size: 0.8125rem; color: var(--color-on-surface-muted); }
  .onb .form-extras__icon {
    margin-left: auto;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-on-surface-variant);
    transition: transform var(--duration-slow) var(--ease-gallery);
  }
  .onb details[open] > summary .form-extras__icon { transform: rotate(45deg); }
  .onb .form-extras__body { padding-top: 2rem; }

  /* Repeat rows (references, songs). */
  .onb-repeat { border: 0; padding: 0; margin: 0; min-width: 0; }
  .onb-repeat > legend { padding: 0; }
  .onb-repeat__help { margin: 0 0 1.25rem; }
  .onb-repeat__rows { display: flex; flex-direction: column; gap: 1rem; }
  .onb-repeat__row { display: flex; gap: 1rem; align-items: flex-start; }
  .onb-repeat__num {
    flex: 0 0 1.5rem;
    padding-top: 2.15rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
  }
  .onb-repeat__cols { flex: 1; min-width: 0; display: grid; gap: 0.75rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) {
    .onb-repeat__cols--3 { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1.4fr); }
    .onb-repeat__cols--3:has(.onb-repeat__col--timestamp) { grid-template-columns: minmax(0, 1.6fr) 6.5rem minmax(0, 1.4fr); }
  }
  .onb-repeat__label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-surface-muted);
  }
  .onb-repeat__add { margin-top: 0.75rem; margin-left: 2.5rem; }

  /* Film picker. */
  .onb-films { border: 0; padding: 0; margin: 0; min-width: 0; }
  .onb-films > legend { padding: 0; }
  .onb-films__help { margin: 0 0 1.5rem; }
  .onb-films__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem 2rem; }
  @media (min-width: 768px) { .onb-films__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .onb-film {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem 1rem;
    padding: 1rem;
    background: var(--color-surface);
    transition: box-shadow var(--duration-slow) var(--ease-gallery);
  }
  .onb-film[data-picked] { box-shadow: inset 0 0 0 2px var(--color-on-surface); }
  .onb-film__media { aspect-ratio: 4 / 5; overflow: hidden; background: var(--color-surface-container); }
  .onb-film__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .onb-film__couple { font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.2; color: var(--color-on-surface); }
  .onb-film__where { margin-top: 0.25rem; font-family: var(--font-sans); font-size: 0.8125rem; line-height: 1.4; color: var(--color-on-surface-variant); }
  .onb-film__links { display: flex; flex-wrap: wrap; gap: 0 1rem; margin: 0.25rem 0 0.5rem; }
  .onb-film__watch {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    color: var(--color-on-surface);
  }
  .onb-film__watch:focus-visible { outline: 2px solid var(--color-on-surface); outline-offset: 2px; }
  .onb-film__note { grid-column: 1 / -1; }
  .onb-film__note-input { font-size: 1rem; padding: 0.75rem 0.875rem; }

  /* Submit, error, done. */
  .onb-submit { margin-top: clamp(4rem, 8vw, 6rem); }
  .onb-submit__problem { margin-bottom: 1.5rem; font-family: var(--font-sans); font-size: 0.9375rem; color: var(--color-error); }
  .onb .form-submit__button { transition-duration: var(--duration-slow); min-height: 3.5rem; }
  .onb .form-submit__button[aria-busy='true'] { opacity: 0.7; cursor: progress; }
  @media (max-width: 639px) { .onb .form-submit__button { width: 100%; } }

  .onb-error { margin-top: 2rem; padding: 1.5rem; background: var(--color-surface); }
  .onb-error__title { font-family: var(--font-sans); font-size: 0.8125rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-error); }
  .onb-error__body { margin-top: 0.5rem; font-family: var(--font-sans); font-size: 1rem; line-height: 1.6; color: var(--color-on-surface-variant); }
  .onb-error__body a { text-decoration: underline; color: var(--color-on-surface); }

  .onb-done { padding: clamp(2rem, 6vw, 4rem); background: var(--color-surface); outline: none; }
  .onb-done__title { max-width: 16ch; }
  .onb-done__lead { margin-top: 1.5rem; color: var(--color-on-surface-variant); max-width: 44ch; }
  .onb-next { margin-top: 2.5rem; border-block: 1px solid color-mix(in srgb, var(--color-on-surface-muted) 25%, transparent); }
  .onb-next__step {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-surface-muted) 15%, transparent);
  }
  .onb-next__step:last-child { border-bottom: 0; }
  .onb-next__numeral {
    flex: 0 0 3.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--color-on-surface);
  }
  .onb-next__body { font-family: var(--font-sans); font-size: 1.0625rem; line-height: 1.55; color: var(--color-on-surface); max-width: 40ch; }
  .onb-done__meta { margin-top: 2rem; font-family: var(--font-serif); font-style: italic; font-size: 1.0625rem; color: var(--color-on-surface-variant); max-width: 46ch; }

  @media (prefers-reduced-motion: reduce) {
    .onb *, .onb *::before, .onb *::after { transition: none !important; }
  }
</style>
