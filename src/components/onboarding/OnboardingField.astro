---
// One schema field, rendered by kind. Every field wrapper carries
// data-onb-field="<name>" plus one .form-error-msg so the page script can
// show and clear errors without knowing the kind. Classes reuse the site's
// inquiry form styles from global.css (.form-field, .form-field__input ...).
import type { FieldDef, Schema } from '../../lib/onboarding';
import { fieldMax, formatPrice } from '../../lib/onboarding';
import packages from '../../data/packages.json';
import FilmPicker from './FilmPicker.astro';
import RepeatRows from './RepeatRows.astro';

interface Props {
  field: FieldDef;
  schema: Schema;
}

const { field, schema } = Astro.props;
const id = `onb-${field.name}`;
const errId = `${id}-error`;
const helpId = `${id}-help`;
const describedBy = [field.help ? helpId : '', errId].filter(Boolean).join(' ');
const max = fieldMax(field, schema);
const inputType = field.kind === 'text' ? 'text' : field.kind;
const isGroup = field.kind === 'radio' || field.kind === 'checkboxes';

// Package options: the schema holds the ids, packages.json holds the names
// and prices, so a price change never needs a second edit here.
const pkgById = new Map((packages as any[]).map((p) => [p.id, p]));
const selectOptions = (field.options ?? []).map((o) => {
  if (field.optionsSource !== 'packages') return { value: o.value, label: o.label ?? o.value };
  const p = pkgById.get(o.value);
  if (!p) throw new Error(`onboarding-fields.json: package "${o.value}" is missing from packages.json`);
  const price = formatPrice(p);
  return { value: o.value, label: price ? `${p.name}, ${price}` : p.name };
});

const widthClass = field.width === 'half' ? 'onb-half' : 'onb-full';

// The first field of an "at least one of these" rule gets the required star,
// the others stay marked optional (e.g. location wishes OR your own places).
const leadsOneOf = (schema.meta.requiredOneOf ?? []).some((r) => r.fields[0] === field.name);
const showRequired = !!field.required || leadsOneOf;
---

{(field.kind === 'films') && (
  <div class:list={['onb-field', widthClass]} data-onb-field={field.name}>
    <FilmPicker field={field} helpId={helpId} errId={errId} />
  </div>
)}

{(field.kind === 'repeat') && (
  <div class:list={['onb-field', widthClass]} data-onb-field={field.name}>
    <RepeatRows field={field} schema={schema} helpId={helpId} errId={errId} />
  </div>
)}

{isGroup && (
  <fieldset
    class:list={['form-field onb-field onb-group', widthClass]}
    data-onb-field={field.name}
    aria-describedby={describedBy}
    aria-required={field.required ? 'true' : undefined}
  >
    <legend class="form-field__label">
      {field.label}
      {showRequired
        ? <span class="form-field__required" aria-hidden="true"> *</span>
        : <span class="form-field__optional"> (optional)</span>}
    </legend>
    <div class="onb-chips">
      {(field.options ?? []).map((o) => (
        <label class="onb-chip">
          <input
            type={field.kind === 'radio' ? 'radio' : 'checkbox'}
            name={field.name}
            value={o.value}
            data-only-with={o.onlyWith ? JSON.stringify(o.onlyWith) : undefined}
          />
          <span>{o.label ?? o.value}</span>
        </label>
      ))}
    </div>
    {field.help && <p id={helpId} class="form-field__help">{field.help}</p>}
    <p id={errId} class="form-error-msg form-field__error" role="alert" hidden></p>
  </fieldset>
)}

{field.kind === 'checkbox' && (
  <div class:list={['form-field onb-field', widthClass]} data-onb-field={field.name}>
    <label class="onb-tick" for={id}>
      <input
        type="checkbox"
        id={id}
        name={field.name}
        value="yes"
        aria-describedby={describedBy}
        aria-required={field.required ? 'true' : undefined}
      />
      <span class="onb-tick__text">
        {field.label}
        {field.required && <span class="form-field__required" aria-hidden="true"> *</span>}
      </span>
    </label>
    {field.privacyNote && (
      <p class="onb-privacy">
        Your answers stay between us and the editor working on your film. See the <a href="/privacy/">privacy policy</a>.
      </p>
    )}
    {field.help && <p id={helpId} class="form-field__help">{field.help}</p>}
    <p id={errId} class="form-error-msg form-field__error" role="alert" hidden></p>
  </div>
)}

{(field.kind === 'select') && (
  <div class:list={['form-field onb-field', widthClass]} data-onb-field={field.name}>
    <label for={id} class="form-field__label">
      {field.label}
      {field.required
        ? <span class="form-field__required" aria-hidden="true"> *</span>
        : <span class="form-field__optional"> (optional)</span>}
    </label>
    <select
      id={id}
      name={field.name}
      class="form-field__select"
      aria-describedby={describedBy}
      aria-required={field.required ? 'true' : undefined}
    >
      <option value="">Choose one</option>
      {selectOptions.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
    {field.help && <p id={helpId} class="form-field__help">{field.help}</p>}
    <p id={errId} class="form-error-msg form-field__error" role="alert" hidden></p>
  </div>
)}

{field.kind === 'textarea' && (
  <div class:list={['form-field onb-field', widthClass]} data-onb-field={field.name}>
    <label for={id} class="form-field__label">
      {field.label}
      {field.required
        ? <span class="form-field__required" aria-hidden="true"> *</span>
        : <span class="form-field__optional"> (optional)</span>}
    </label>
    <textarea
      id={id}
      name={field.name}
      rows={field.rows ?? 4}
      maxlength={max}
      placeholder={field.placeholder}
      class="form-field__textarea"
      aria-describedby={describedBy}
      aria-required={field.required ? 'true' : undefined}
    ></textarea>
    {field.help && <p id={helpId} class="form-field__help">{field.help}</p>}
    <p id={errId} class="form-error-msg form-field__error" role="alert" hidden></p>
  </div>
)}

{['text', 'email', 'tel', 'date', 'url'].includes(field.kind) && (
  <div class:list={['form-field onb-field', widthClass]} data-onb-field={field.name}>
    <label for={id} class="form-field__label">
      {field.label}
      {field.required
        ? <span class="form-field__required" aria-hidden="true"> *</span>
        : <span class="form-field__optional"> (optional)</span>}
    </label>
    <input
      type={inputType}
      id={id}
      name={field.name}
      maxlength={field.kind === 'date' ? undefined : max}
      placeholder={field.placeholder}
      autocomplete={field.autocomplete ?? 'off'}
      inputmode={field.kind === 'url' ? 'url' : undefined}
      class="form-field__input"
      aria-describedby={describedBy}
      aria-required={field.required ? 'true' : undefined}
    />
    {field.help && <p id={helpId} class="form-field__help">{field.help}</p>}
    <p id={errId} class="form-error-msg form-field__error" role="alert" hidden></p>
    {field.kind === 'url' && <p class="onb-warn" data-onb-warn hidden></p>}
  </div>
)}
