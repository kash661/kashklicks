---
// All 109 places from locations.json, grouped by zone in native <details>.
// Places with a photo in src/assets/images/locations/ render as photo cards,
// the rest as compact text rows (same split as /location-guide/). Tap order
// is the rank; the page script writes the number into each badge and into
// the pre-rendered "Your picks" slots, so no nodes are created at runtime.
import { Image } from 'astro:assets';
import type { FieldDef } from '../../lib/onboarding';
import locations from '../../data/locations.json';

interface Props {
  field: FieldDef;
  helpId: string;
  errId: string;
}

const { field, helpId, errId } = Astro.props;
const max = field.maxItems ?? 8;

const locationImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/locations/*.jpg', { eager: true });

// Same city order as the location guide, downtown first.
const zoneOrder = [
  'Downtown', 'North York', 'East York', 'Scarborough', 'Etobicoke', 'Mississauga', 'Brampton',
  'Caledon', 'Vaughan', 'Markham', 'Richmond Hill', 'Oakville', 'Halton', 'Burlington',
  'Hamilton', 'Niagara', 'Oshawa', 'Durham',
];
const zoneTitles: Record<string, string> = { Downtown: 'Downtown Toronto' };

const all = (locations as any[]).map((l) => ({
  id: String(l.id),
  name: String(l.name),
  area: String(l.area ?? ''),
  zone: String(l.zone ?? 'Elsewhere'),
  img: l.image ? locationImages[`/src/assets/images/locations/${l.image}`]?.default ?? null : null,
  haystack: `${l.name} ${l.area ?? ''} ${l.zone ?? ''} ${l.vibe ?? ''}`.toLowerCase(),
}));

const zones = [...new Set(all.map((l) => l.zone))].sort((a, b) => {
  const ia = zoneOrder.indexOf(a);
  const ib = zoneOrder.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b);
});

const groups = zones.map((zone) => {
  const items = all.filter((l) => l.zone === zone).sort((a, b) => a.name.localeCompare(b.name));
  return {
    zone,
    title: zoneTitles[zone] ?? zone,
    cards: items.filter((l) => l.img),
    rows: items.filter((l) => !l.img),
    total: items.length,
  };
});
---

<fieldset class="onb-locs" data-onb-locs data-max={max} aria-describedby={`${helpId} ${errId}`}>
  <legend class="form-field__label">
    {field.label} <span class="form-field__required" aria-hidden="true">*</span>
  </legend>
  {field.help && <p id={helpId} class="form-field__help">{field.help}</p>}

  <div class="onb-locs__picks" aria-live="polite">
    <p class="onb-locs__picks-title">Your picks</p>
    <p class="onb-locs__empty" data-loc-empty>Nothing picked yet.</p>
    <ol class="onb-locs__picklist">
      {Array.from({ length: max }, (_, i) => (
        <li class="onb-locs__slot" data-loc-slot hidden>
          <span class="onb-locs__slot-rank">{i + 1}</span>
          <span class="onb-locs__slot-name" data-loc-slot-name></span>
          <button type="button" class="onb-link-btn onb-locs__remove" data-loc-remove>
            Remove<span class="sr-only" data-loc-slot-sr></span>
          </button>
        </li>
      ))}
    </ol>
    <p class="onb-locs__cap" data-loc-cap hidden>You have picked {max}. Remove one to add another.</p>
  </div>

  <div class="form-field onb-locs__search">
    <label for="onb-loc-search" class="form-field__label">Search places</label>
    <input
      type="search"
      id="onb-loc-search"
      class="form-field__input"
      placeholder="Casa Loma, waterfront, garden..."
      autocomplete="off"
      data-loc-search
    />
    <p class="onb-locs__none" data-loc-none hidden>No places match. Add it under "Somewhere not on the list" below.</p>
  </div>

  <div class="onb-locs__groups">
    {groups.map((g, gi) => (
      <details class="onb-locs__group" data-loc-group open={gi === 0}>
        <summary class="onb-locs__summary">
          <span class="onb-locs__zone">{g.title}</span>
          <span class="onb-locs__meta">
            <span data-loc-group-count hidden></span>
            <span>{g.total} {g.total === 1 ? 'place' : 'places'}</span>
          </span>
          <span class="onb-locs__icon" aria-hidden="true">+</span>
        </summary>

        <div class="onb-locs__body">
          {g.cards.length > 0 && (
            <ul class="onb-locs__cards">
              {g.cards.map((l) => (
                <li data-loc-item data-haystack={l.haystack}>
                  <label class="onb-loc-card">
                    <input type="checkbox" name="locations" value={l.id} data-loc-name={l.name} class="onb-loc-input" />
                    <span class="onb-loc-card__media">
                      <Image
                        src={l.img!}
                        alt=""
                        widths={[240, 480]}
                        sizes="(max-width: 640px) 46vw, 13rem"
                        quality={65}
                        format="avif"
                        loading="lazy"
                        class="onb-loc-card__img"
                      />
                      <span class="onb-loc-badge" data-loc-badge aria-hidden="true"></span>
                    </span>
                    <span class="onb-loc-card__name">{l.name}</span>
                    <span class="onb-loc-card__area">{l.area}</span>
                  </label>
                </li>
              ))}
            </ul>
          )}
          {g.rows.length > 0 && (
            <ul class="onb-locs__rows">
              {g.rows.map((l) => (
                <li data-loc-item data-haystack={l.haystack}>
                  <label class="onb-loc-row">
                    <input type="checkbox" name="locations" value={l.id} data-loc-name={l.name} class="onb-loc-input" />
                    <span class="onb-loc-badge onb-loc-badge--row" data-loc-badge aria-hidden="true"></span>
                    <span class="onb-loc-row__text">
                      <span class="onb-loc-row__name">{l.name}</span>
                      <span class="onb-loc-row__area">{l.area}</span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          )}
        </div>
      </details>
    ))}
  </div>
  <p id={errId} class="form-error-msg form-field__error" role="alert" hidden></p>
</fieldset>
