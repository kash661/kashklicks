---
// N rows rendered up front. Rows 2..N start hidden and "Add another" reveals
// the next one, so no nodes are created at runtime (Astro scoped styles miss
// runtime nodes). Inputs are named <field>.<row>.<column>.
import type { FieldDef, Schema } from '../../lib/onboarding';
import { fieldMax } from '../../lib/onboarding';

interface Props {
  field: FieldDef;
  schema: Schema;
  helpId: string;
  errId: string;
}

const { field, schema, helpId, errId } = Astro.props;
const rows = field.rows ?? 3;
const cols = field.columns ?? [];
---

<fieldset class="onb-repeat" data-onb-repeat aria-describedby={`${field.help ? helpId : ''} ${errId}`.trim()}>
  <legend class="form-field__label">
    {field.label}
    {field.required
      ? <span class="form-field__required" aria-hidden="true"> *</span>
      : <span class="form-field__optional"> (optional)</span>}
  </legend>
  {field.help && <p id={helpId} class="form-field__help onb-repeat__help">{field.help}</p>}

  <ol class="onb-repeat__rows">
    {Array.from({ length: rows }, (_, i) => (
      <li class="onb-repeat__row" data-repeat-row hidden={i > 0}>
        <span class="onb-repeat__num" aria-hidden="true">{i + 1}</span>
        <div class:list={['onb-repeat__cols', `onb-repeat__cols--${cols.length}`]}>
          {cols.map((col) => {
            const inputId = `onb-${field.name}-${i}-${col.name}`;
            return (
              <div class:list={['onb-repeat__col', `onb-repeat__col--${col.name}`]}>
                <label for={inputId} class="onb-repeat__label">
                  {col.label}<span class="sr-only">, row {i + 1}</span>
                </label>
                <input
                  type={col.kind === 'url' ? 'url' : 'text'}
                  inputmode={col.kind === 'url' ? 'url' : undefined}
                  id={inputId}
                  name={`${field.name}.${i}.${col.name}`}
                  maxlength={fieldMax(col, schema)}
                  placeholder={col.placeholder}
                  autocomplete="off"
                  class="form-field__input"
                />
              </div>
            );
          })}
        </div>
      </li>
    ))}
  </ol>

  {rows > 1 && (
    <button type="button" class="onb-link-btn onb-repeat__add" data-repeat-add>
      <span aria-hidden="true">+</span> Add another
    </button>
  )}
  <p class="onb-warn" data-onb-warn hidden></p>
  <p id={errId} class="form-error-msg form-field__error" role="alert" hidden></p>
</fieldset>
