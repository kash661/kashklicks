---
const eventTypeOptions = [
  { value: 'wedding', label: 'Wedding' },
  { value: 'pre-wedding', label: 'Pre-Wedding / Engagement' },
  { value: 'proposal', label: 'Proposal' },
  { value: 'civil-ceremony', label: 'Civil Ceremony' },
  { value: 'celebration', label: 'Celebration' },
  { value: 'headshots', label: 'Headshots' },
  { value: 'unsure', label: 'Not sure yet' },
];

const referralOptions = [
  { value: 'instagram', label: 'Instagram' },
  { value: 'google', label: 'Google search' },
  { value: 'reddit', label: 'Reddit' },
  { value: 'referral', label: 'A friend or family member' },
  { value: 'planner', label: 'Wedding planner or vendor' },
  { value: 'blog', label: 'Blog, article, or feature' },
  { value: 'other', label: 'Somewhere else' },
];

// Local-pivot qualifier. A four-rung geographic ladder so destination work
// (elsewhere in Canada vs outside Canada) is separable from local GTA work.
// Forwarded by worker.ts into the Inquiries sheet as `event_region`.
const regionOptions = [
  { value: 'toronto-gta', label: 'Toronto / GTA' },
  { value: 'ontario', label: 'Elsewhere in Ontario' },
  { value: 'canada', label: 'Elsewhere in Canada' },
  { value: 'international', label: 'Outside Canada' },
];
---

<div id="contact-form-wrapper">
  <form
    id="contact-form"
    action="/r/intake"
    method="POST"
    novalidate
  >
    <!-- Honeypot -->
    <div class="absolute -left-[9999px] opacity-0 h-0 w-0 overflow-hidden" aria-hidden="true">
      <label for="_gotcha">Don't fill this out</label>
      <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Hidden context — auto-filled when Enquire is clicked from a
         specific package CTA, or set via URL params on inline form. -->
    <input type="hidden" id="package_id" name="package_id" value="" />
    <input type="hidden" id="package_name" name="package_name" value="" />
    <input type="hidden" id="source_page" name="source_page" value="" />

    <!-- Date-first framing: the photographer books a limited number of dates
         each year, so the inquiry opens on the date before anything else. -->
    <p class="form-intro">I book a limited number of dates each year, so let's start with yours.</p>

    <!-- ═══ Required fields, date-first ═══ -->
    <div class="form-required-stack">
      <div class="form-field">
        <label for="event_date" class="form-field__label">
          Your Date <span class="form-field__required" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          inputmode="text"
          id="event_date"
          name="event_date"
          required
          aria-required="true"
          aria-describedby="event_date-error"
          placeholder='e.g. June 2027, or "not sure yet"'
          autocomplete="off"
          class="form-field__input"
        />
        <p id="event_date-error" class="form-error-msg form-field__error hidden" role="alert"></p>
      </div>

      <div class="form-field">
        <label for="name" class="form-field__label">
          Your Name <span class="form-field__required" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          autocomplete="given-name"
          required
          aria-required="true"
          aria-describedby="name-error"
          class="form-field__input"
        />
        <p id="name-error" class="form-error-msg form-field__error hidden" role="alert"></p>
      </div>

      <div class="form-field">
        <label for="email" class="form-field__label">
          Email <span class="form-field__required" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          aria-required="true"
          aria-describedby="email-error"
          class="form-field__input"
        />
        <p id="email-error" class="form-error-msg form-field__error hidden" role="alert"></p>
      </div>

      <div class="form-field">
        <label for="event_region" class="form-field__label">
          Where will it take place? <span class="form-field__required" aria-hidden="true">*</span>
        </label>
        <select
          id="event_region"
          name="event_region"
          required
          aria-required="true"
          aria-describedby="event_region-error"
          class="form-field__select"
        >
          <option value="" disabled selected>Select a region</option>
          {regionOptions.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>
        <p id="event_region-error" class="form-error-msg form-field__error hidden" role="alert"></p>
      </div>

      <div class="form-field">
        <label for="event_type" class="form-field__label">
          What I'm Capturing <span class="form-field__required" aria-hidden="true">*</span>
        </label>
        <select
          id="event_type"
          name="event_type"
          required
          aria-required="true"
          aria-describedby="event_type-error"
          class="form-field__select"
        >
          <option value="" disabled selected>Select an occasion</option>
          {eventTypeOptions.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>
        <p id="event_type-error" class="form-error-msg form-field__error hidden" role="alert"></p>
      </div>

      <div class="form-field">
        <label for="referral" class="form-field__label">
          How Did You Find Me? <span class="form-field__optional">(optional)</span>
        </label>
        <select
          id="referral"
          name="referral"
          aria-describedby="referral-error"
          class="form-field__select"
        >
          <option value="" disabled selected>Select one</option>
          {referralOptions.map((opt) => (
            <option value={opt.value}>{opt.label}</option>
          ))}
        </select>
        <p id="referral-error" class="form-error-msg form-field__error hidden" role="alert"></p>
      </div>

      <div class="form-field">
        <label for="message" class="form-field__label">
          Tell Me About Your Day <span class="form-field__required" aria-hidden="true">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          aria-required="true"
          aria-describedby="message-error"
          rows="5"
          placeholder="Your story, the mood you're going for, Pinterest or Instagram links. Anything that helps me understand the day."
          class="form-field__textarea"
        ></textarea>
        <p id="message-error" class="form-error-msg form-field__error hidden" role="alert"></p>
      </div>
    </div>

    <!-- ═══ Optional fields — collapsed by default, native <details> so it
         works pre-hydration on any device. ═══ -->
    <details class="form-extras">
      <summary class="form-extras__summary">
        <span class="form-extras__label">Add more details</span>
        <span class="form-extras__hint">(optional, helps me prep)</span>
        <span class="form-extras__icon" aria-hidden="true">+</span>
      </summary>

      <div class="form-extras__body">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-8">
          <div class="form-field">
            <label for="partner_name" class="form-field__label">
              Partner's Name <span class="form-field__optional">(if applicable)</span>
            </label>
            <input
              type="text"
              id="partner_name"
              name="partner_name"
              class="form-field__input"
            />
          </div>

          <div class="form-field">
            <label for="phone" class="form-field__label">
              Phone <span class="form-field__optional">(optional)</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              placeholder="(416) 555 0199"
              class="form-field__input"
            />
          </div>

          <div class="form-field">
            <label for="guest_count" class="form-field__label">
              Approx. Guest Count <span class="form-field__optional">(optional)</span>
            </label>
            <input
              type="text"
              id="guest_count"
              name="guest_count"
              placeholder="e.g. 50, 100+, or just the two of us"
              class="form-field__input"
            />
          </div>

          <div class="form-field sm:col-span-2">
            <label for="location" class="form-field__label">
              Venue or Location <span class="form-field__optional">(optional)</span>
            </label>
            <input
              type="text"
              id="location"
              name="location"
              placeholder="Venue name, a city, or 'Not sure yet'"
              class="form-field__input"
            />
          </div>
        </div>
      </div>
    </details>

    <!-- Submit -->
    <div class="form-submit">
      <div class="form-submit__break"></div>
      <button type="submit" class="form-submit__button">
        Send Inquiry
        <span class="form-submit__arrow" aria-hidden="true">&rarr;</span>
      </button>
      <p class="form-submit__note">
        <span class="form-field__required not-italic" aria-hidden="true">*</span> required, the rest is optional. Share what you can.
      </p>
      <p class="form-submit__reply">
        Reply within 24 hours, every time.
      </p>
    </div>
  </form>

  <!-- Success state -->
  <div id="contact-success" class="hidden contact-success p-10" role="status" aria-live="polite">
    <p class="text-label-md contact-success__eyebrow eyebrow-rule revealed mb-4">Sent · Thank You</p>
    <h3 class="text-heading-lg font-serif contact-success__heading">Your note is on its way.</h3>
    <p class="text-body-lg contact-success__body mt-4" style="max-width: 50ch;">
      I'll read it carefully and reply within 24 hours to start planning something with you.
    </p>
    <p class="text-label-sm contact-success__meta mt-6">
      In the meantime, browse my <a href="/portfolio/" class="contact-success__link cubic-ease underline" style="transition-duration: var(--duration-hover);">portfolio</a> for inspiration.
    </p>
  </div>

  <!-- Error state -->
  <div id="contact-error" class="hidden bg-surface-dim p-6" role="alert" aria-live="assertive">
    <div class="flex items-start gap-4">
      <svg class="h-5 w-5 mt-0.5 shrink-0 text-on-surface" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <p class="text-label-md text-on-surface">Something went wrong</p>
        <p class="mt-1 text-body-lg text-on-surface-variant">Your message couldn't be sent. Please try again, or reach out directly at <a href="mailto:info@kashklicks.ca" class="underline hover:text-on-surface transition-interactive" style="transition-duration: var(--duration-hover-ui);">info@kashklicks.ca</a> or DM me on Instagram for a faster reply.</p>
        <button
          id="contact-retry-btn"
          type="button"
          class="mt-3 text-label-md text-on-surface-variant hover:text-on-surface cubic-ease underline"
          style="transition-duration: var(--duration-hover);"
        >
          Try again
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .form-intro {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    margin-bottom: 2rem;
    max-width: 46ch;
  }

  .form-required-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-extras {
    margin-top: 2.5rem;
    border-top: 1px solid rgba(175, 179, 174, 0.25);
    padding-top: 1.5rem;
  }

  .form-extras__summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0;
  }
  .form-extras__summary::-webkit-details-marker { display: none; }
  .form-extras__summary::marker { content: ''; }

  .form-extras__label {
    font-size: 0.8125rem;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-on-surface);
  }

  .form-extras__hint {
    font-size: 0.8125rem;
    font-family: var(--font-sans);
    color: var(--color-on-surface-muted);
  }

  .form-extras__icon {
    margin-left: auto;
    font-size: 1.5rem;
    color: var(--color-on-surface-variant);
    transition: transform var(--duration-hover-ui, var(--duration-hover)) var(--ease-gallery);
    transform-origin: center;
    line-height: 1;
  }
  .form-extras[open] > .form-extras__summary .form-extras__icon {
    transform: rotate(45deg);
  }

  .form-extras__body {
    padding-top: 2rem;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-gallery);
  }
  .form-extras[open] > .form-extras__body {
    opacity: 1;
  }

  .form-submit__reply {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-family: var(--font-sans);
    color: var(--color-on-surface-muted);
    letter-spacing: 0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .form-extras__body,
    .form-extras__icon {
      transition: none;
    }
    .form-extras[open] > .form-extras__body { opacity: 1; }
  }

  .contact-success {
    background: #e7eede;
  }
  .contact-success__eyebrow { color: #4f6342; }
  .contact-success .eyebrow-rule::after { background: #4f6342; }
  .contact-success__heading { color: #283322; }
  .contact-success__body { color: #4b5840; }
  .contact-success__meta { color: #6b765f; }
  .contact-success__link { color: #283322; transition-property: color; }
  .contact-success__link:hover { color: #4f6342; }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;
    if ((form as any).__bound) return;
    (form as any).__bound = true;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const successEl = document.getElementById('contact-success');
    const errorEl = document.getElementById('contact-error');
    const retryBtn = document.getElementById('contact-retry-btn');

    if (!submitBtn || !successEl || !errorEl) return;

    const originalBtnText = submitBtn.textContent;

    // URL-param prefill — when PricingCard graceful-degrades to /contact/,
    // its href carries ?service=...&package=...&package_name=... and #inquiry.
    // Mirror what ContactModal does for in-place opens.
    function applyUrlPrefill() {
      const params = new URLSearchParams(window.location.search);
      const sourcePage = form!.querySelector<HTMLInputElement>('#source_page');
      // Location guides and venue pages link here with ?location=/?venue=.
      // Fold that into source_page so the sheet keeps the attribution.
      const refLocation = params.get('location') || params.get('venue');
      if (sourcePage) {
        sourcePage.value = window.location.pathname + (refLocation ? ` (via ${refLocation})` : '');
      }

      const service = params.get('service');
      if (service) {
        const select = form!.querySelector<HTMLSelectElement>('#event_type');
        if (select && Array.from(select.options).some((o) => o.value === service)) {
          select.value = service;
        }
      }

      const pkg = params.get('package');
      if (pkg) {
        const pkgInput = form!.querySelector<HTMLInputElement>('#package_id');
        if (pkgInput) pkgInput.value = pkg;
      }

      const pkgName = params.get('package_name');
      if (pkgName) {
        const pkgNameInput = form!.querySelector<HTMLInputElement>('#package_name');
        if (pkgNameInput) pkgNameInput.value = pkgName;
      }
    }
    applyUrlPrefill();

    function clearFieldError(field: HTMLElement) {
      const errMsg = field.closest('.form-field')?.querySelector('.form-error-msg') as HTMLElement | null;
      if (errMsg) {
        errMsg.textContent = '';
        errMsg.classList.add('hidden');
      }
      field.removeAttribute('aria-invalid');
    }

    function showFieldError(field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, message: string) {
      const errMsg = field.closest('.form-field')?.querySelector('.form-error-msg') as HTMLElement | null;
      if (errMsg) {
        errMsg.textContent = message;
        errMsg.classList.remove('hidden');
      }
      field.setAttribute('aria-invalid', 'true');
    }

    function validateForm(): boolean {
      let valid = true;
      let firstInvalid: HTMLElement | null = null;
      const requiredFields = form!.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[required]');

      requiredFields.forEach((field) => {
        clearFieldError(field);

        if (!field.value.trim()) {
          showFieldError(field, 'This field is required.');
          valid = false;
          if (!firstInvalid) firstInvalid = field;
        } else if (field.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value.trim())) {
          showFieldError(field, 'Please enter a valid email address.');
          valid = false;
          if (!firstInvalid) firstInvalid = field;
        }
      });

      if (firstInvalid) (firstInvalid as HTMLElement).focus();
      return valid;
    }

    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((field) => {
      field.addEventListener('input', () => clearFieldError(field));
      field.addEventListener('change', () => clearFieldError(field));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateForm()) return;

      const honeypot = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
      if (honeypot && honeypot.value) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      errorEl.classList.add('hidden');

      try {
        const formData = new FormData(form);
        formData.delete('_gotcha');

        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json',
          },
        });

        if (response.ok) {
          form.classList.add('hidden');
          successEl.classList.remove('hidden');
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });

          // Ad-platform conversion events. No engagement gate here: unlike the
          // paid LP, completing this 7-field form is itself the qualification.
          // try/catch because tracking must never break the success UI
          // (in-app browsers can throw on blocked storage/APIs).
          try {
            const sourcePage = location.pathname || '/contact/';
            if (typeof window.fbq === 'function') {
              window.fbq('track', 'Lead', {
                content_name: sourcePage,
                content_category: 'wedding-inquiry',
              });
            }
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'conversion', {
                send_to: 'AW-18099849669/T8MMCMX8gp4cEMWT17ZD',
                value: 650.0,
                currency: 'CAD',
                transaction_id: '',
              });
            }
            if (typeof window.clarity === 'function') {
              window.clarity('event', 'lead_form_submit');
            }
          } catch {
            /* never block the success state on tracking */
          }
        } else {
          throw new Error(`Form submission failed: ${response.status}`);
        }
      } catch {
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    });

    retryBtn?.addEventListener('click', () => {
      errorEl.classList.add('hidden');
      form.classList.remove('hidden');
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
