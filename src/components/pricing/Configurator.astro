---
/**
 * Hallmark · macrostructure: Workbench · genre: editorial
 * theme: locked (Digital Curator, defers to .claude/CLAUDE.md)
 * enrichment: client photography (real category covers from portfolio.json)
 * motion: 2 primitives (step reveal + stagger, total opacity)
 * pre-emit critique: P5 H5 E4 S5 R4 V4
 *
 * The guided pricing configurator. Progressive enhancement: every category,
 * package, question and add-on is server rendered. With no JS the page reads
 * as a complete stacked price list. The script hides all but the active step.
 *
 * One DOM tree, not two. Duplicating form controls for a mobile tree would
 * give every field two elements with the same name, which Apps Script's
 * e.parameter collapses to the first value. Layout splits in the CSS.
 *
 * Visual language copied from the shipped .pricing-card system in global.css
 * (generous padding, serif italic badge, hairline borders via color-mix,
 * small caps eyebrow) so this page reads as part of the site.
 */
import { Image } from 'astro:assets';
import packagesData from '../../data/packages.json';
import flow from '../../data/pricing-flow.json';
import { ADD_ONS, isCountable, basePrice, priceQualifier } from '../../lib/addons';
import BookingLink from '../ui/BookingLink.astro';
import locationsData from '../../data/locations.json';

const packages = packagesData as Array<Record<string, any>>;
const money = (n: number) =>
  '$' + n.toLocaleString('en-CA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// One image per category, each chosen by Akash. Explicit imports rather than a
// glob: they are hand-picked, one is a homepage asset and one is a frame inside
// a gallery subfolder, so the portfolio glob would not reach either.
const CATEGORY_IMAGE: Record<string, ImageMetadata> = {
  // Josie + Nelson under the veil at Guild Park. Deliberately not their
  // pre-wedding cover, which is where they are filed in portfolio.json.
  wedding: (await import('../../assets/images/homepage/homepage-10-josie-nelson-veil.jpg')).default,
  prewedding: (await import('../../assets/images/portfolio/swati-saksham-cover.jpg')).default,
  // Akash's own pick for civil: the couple kissing in front of a columned stone
  // facade on cobblestones, shot with deliberate motion blur. Not a gallery
  // frame. The original was not on this machine, so this is the copy he sent
  // at 1333x2000, more than double the 640px the card ever renders at.
  civil: (await import('../../assets/images/pricing/civil-motion-blur-kiss.jpg')).default,
  // Ashley + Donald, frame 03, chosen off its caption: "Donald down on one knee
  // by the rose beds at Château des Charmes as Ashley brings a hand to her
  // mouth". The only frame in the gallery that shows the proposal itself, and
  // the château behind them reads as the kind of place people book this for.
  proposal: (await import('../../assets/images/portfolio/ashley-donald/03.jpg')).default,
  // Akash's own pick for celebrations: a guest mid dance at Zoha + Moe's
  // anniversary party in Maple, arms out, the room full behind him. A frame
  // that never made the gallery, so it lives here rather than in portfolio/.
  celebration: (await import('../../assets/images/pricing/celebration-zoha-moe.jpg')).default,
  headshots: (await import('../../assets/images/homepage/headshots-service-detail.jpg')).default,
};
const coverFor = (catId: string): ImageMetadata | undefined => CATEGORY_IMAGE[catId];

const permitIndex = (locationsData as Array<Record<string, any>>)
  .filter((l) => l.permitNeeded)
  .map((l) => ({ name: l.name, fee: l.permitFee ?? null }));

const pkgIndex = packages.map((p) => ({
  id: p.id, category: p.category, price: basePrice(p), qualifier: priceQualifier(p),
  // basePrice() returns null for a rate so it is never summed as a total. The
  // rate itself still has to reach the client or it renders as $0.00.
  rate: p.priceIsRate ? p.price : null,
  film: !!p.film, regions: p.regions ?? null, addOnIds: p.addOnIds ?? [],
  hours: p.hours?.included ?? null, name: p.name,
}));
const addOnIndex = ADD_ONS.map((a) => ({
  id: a.id, price: a.price, unit: a.unit, max: a.max ?? null,
  countable: isCountable(a), label: a.label,
}));

/** Price as two parts, so the number can be styled apart from its qualifier. */
function priceParts(a: typeof ADD_ONS[number]) {
  if (a.unit === 'quote') return { num: null, suffix: 'Quoted for you' };
  if (a.unit === 'at-cost') return { num: a.price != null ? money(a.price) : null, suffix: a.price != null ? 'at cost, from' : 'At cost' };
  if (a.unit === 'included') return { num: null, suffix: 'Included' };
  const num = money(a.price as number);
  const suffix =
    a.unit === 'per-hour' ? 'per hour' : a.unit === 'per-person' ? 'per person'
    : a.unit === 'per-year' ? 'per year' : a.unit === 'deposit' ? 'refundable deposit'
    : ['per-image', 'per-item', 'per-roll'].includes(a.unit) ? 'each' : '';
  return { num, suffix };
}
---

<form class="cfg cfg--shell" data-cfg action="/book/intake" method="POST" novalidate aria-label="Build your package">
  <div class="cfg-hp" aria-hidden="true">
    <label for="cfg-gotcha">Leave this empty</label>
    <input type="text" id="cfg-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="_subject" value="Pricing configurator" />
  <input type="hidden" name="source" value="Pricing configurator" />
  <input type="hidden" name="event_type" data-cfg-field="event_type" />
  <input type="hidden" name="event_region" data-cfg-field="event_region" />
  <input type="hidden" name="package_id" data-cfg-field="package_id" />
  <input type="hidden" name="package_name" data-cfg-field="package_name" />
  <input type="hidden" name="addons_json" data-cfg-field="addons_json" />
  <input type="hidden" name="addons_readable" data-cfg-field="addons_readable" />
  <input type="hidden" name="estimate_total" data-cfg-field="estimate_total" />
  <input type="hidden" name="answers_readable" data-cfg-field="answers_readable" />
  <input type="hidden" name="source_page" data-cfg-field="source_page" />

  <div class="cfg-top">
  <div class="cfg-head" data-cfg-nav hidden>
    <button type="button" class="cfg-back" data-cfg-back>
      <span class="cfg-back__arrow" aria-hidden="true">&larr;</span> Back
    </button>
    <span class="cfg-count" data-cfg-count aria-live="polite"></span>
  </div>
  <div class="cfg-rule" data-cfg-rule aria-hidden="true"><span data-cfg-rule-fill></span></div>
  </div>

  <div class="cfg-body">
  <div class="cfg-flow">

  {/* ── 1 · what are you planning ───────────────────────────────── */}
  <section class="cfg-step" data-step="category">
    <fieldset class="cfg-fieldset">
      <legend class="cfg-ask text-display-md measure-tight">What are you planning?</legend>
      <div class="cfg-cards">
        {flow.categories.map((c, i) => {
          const img = coverFor(c.id);
          return (
            <button
              type="button"
              class:list={['cfg-card', 'reveal', `stagger-${(i % 5) + 1}`]}
              data-cfg-category={c.id}
              data-category={c.category}
            >
              {img && (
                <span class="cfg-card__frame">
                  {/* width/height pinned so the src fallback is not emitted at the
                      full 2560px source, which blew past the cover weight target. */}
                  <Image
                    src={img} alt="" class="cfg-card__img"
                    width={640} height={800} widths={[400, 640]}
                    sizes="(min-width: 768px) 32vw, 92vw"
                    format="avif" quality={62}
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                </span>
              )}
              <span class="cfg-card__body">
                <span class="cfg-card__label text-heading-md">{c.label}</span>
                <span class="cfg-card__blurb">{c.blurb}</span>
              </span>
            </button>
          );
        })}
      </div>
    </fieldset>
  </section>

  {/* ── 2 · the narrowing questions ─────────────────────────────── */}
  {Object.entries(flow.questions).map(([catId, qs]) => (qs as any[]).map((q, qi) => (
    <section class="cfg-step" data-step="question" data-q-category={catId} data-q-id={q.id} data-q-index={qi}>
      <fieldset class="cfg-fieldset">
        <legend class="cfg-ask text-display-md measure-tight">{q.ask}</legend>
        {q.hint && <p class="cfg-hint text-body-md">{q.hint}</p>}
        <div class="cfg-options">
          {(q.options as any[]).map((o, oi) => (
            <button
              type="button" class:list={['cfg-opt', 'reveal', `stagger-${(oi % 5) + 1}`]}
              data-cfg-answer={oi}
              data-package-id={o.packageId ?? null} data-add-on-id={o.addOnId ?? null}
              data-region={o.region ?? null} data-film={o.film === undefined ? null : String(o.film)}
            >
              <span class="cfg-opt__mark" aria-hidden="true"></span>
              <span class="cfg-opt__text">
                <span class="cfg-opt__label">{o.label}</span>
                {o.hint && <span class="cfg-opt__hint">{o.hint}</span>}
              </span>
            </button>
          ))}
        </div>
      </fieldset>
    </section>
  )))}

  {/* ── 3 · the packages ─────────────────────────────────────────── */}
  <section class="cfg-step" data-step="packages">
    <h2 class="cfg-ask text-display-md measure-tight">Here is what fits.</h2>
    <p class="cfg-hint text-body-md" data-cfg-estimate-note hidden>
      Every price here is for photography. Film is quoted separately. For a wedding this is an estimate. I confirm it with you on the call, once I know the day properly.
    </p>
    <div class="cfg-packages">
      {packages.map((p, i) => {
        const base = basePrice(p);
        const qual = priceQualifier(p);
        const onSale = p.salePrice != null && p.price != null;
        return (
          <article
            class:list={['cfg-pkg', 'reveal', `stagger-${(i % 5) + 1}`]}
            data-package={p.id} data-category={p.category}
            data-film={String(!!p.film)} data-regions={p.regions ? p.regions.join(',') : ''}
            data-price={base ?? ''} data-qualifier={qual}
          >
            <span class="cfg-pkg__badge" data-cfg-badge hidden>Recommended</span>
            <header class="cfg-pkg__head">
              <p class="cfg-pkg__eyebrow">
                <span>{p.category}</span>
                <span class="cfg-pkg__coverage">{p.film ? 'Photo and film' : 'Photo only'}</span>
              </p>
              <h3 class="cfg-pkg__name text-heading-lg">{p.name}</h3>
              <p class="cfg-pkg__price">
                {qual === 'rate' && <><span class="cfg-pkg__qual">from</span> <span class="cfg-pkg__num">{money(p.price)}</span> <span class="cfg-pkg__qual">per hour</span></>}
                {qual === 'from' && <><span class="cfg-pkg__qual">from</span> <span class="cfg-pkg__num">{money(base!)}</span></>}
                {qual === 'firm' && <>
                  <span class="cfg-pkg__num">{money(base!)}</span>
                  {onSale && <span class="cfg-pkg__was">{money(p.price)}</span>}
                </>}
                {qual === 'none' && <span class="cfg-pkg__num">Priced with you</span>}
              </p>
              <p class="cfg-pkg__duration">{p.duration}</p>
            </header>
            <p class="cfg-pkg__desc text-body-md">{p.description}</p>
            <ul class="cfg-pkg__list">
              {(p.highlights ?? []).map((h: string) => <li>{h}</li>)}
            </ul>
            <button type="button" class="cfg-btn cfg-pkg__choose" data-cfg-choose={p.id}>Choose this one</button>
          </article>
        );
      })}
    </div>
  </section>

  {/* ── 4 · add-ons ──────────────────────────────────────────────── */}
  <section class="cfg-step" data-step="addons">
    <h2 class="cfg-ask text-display-md measure-tight">Anything to add?</h2>
    <p class="cfg-hint text-body-md">All optional. Nothing here is assumed, and you can change it on the call.</p>
    <div class="cfg-addons">
      {ADD_ONS.map((a, i) => {
        const { num, suffix } = priceParts(a);
        return (
          <div
            class:list={['cfg-addon', 'reveal', `stagger-${(i % 5) + 1}`]}
            data-addon={a.id} data-unit={a.unit}
            data-price={a.price ?? ''} data-max={a.max ?? ''} data-countable={String(isCountable(a))}
          >
            <label class="cfg-addon__row">
              <input type="checkbox" class="cfg-addon__input" data-cfg-addon-toggle={a.id} />
              <span class="cfg-addon__mark" aria-hidden="true"></span>
              <span class="cfg-addon__text">
                <span class="cfg-addon__label">{a.label}</span>
                {a.note && <span class="cfg-addon__note">{a.note}</span>}
              </span>
              <span class="cfg-addon__price">
                {num && <span class="cfg-addon__num">{num}</span>}
                {suffix && <span class="cfg-addon__suffix">{suffix}</span>}
              </span>
            </label>
            {isCountable(a) && (
              <div class="cfg-addon__qty" data-cfg-qty-wrap hidden>
                <span class="cfg-addon__qty-label">How many?</span>
                <button type="button" class="cfg-step-btn" data-cfg-qty-down aria-label={`Fewer ${a.label}`}>&minus;</button>
                <output class="cfg-addon__n" data-cfg-qty aria-live="polite">1</output>
                <button type="button" class="cfg-step-btn" data-cfg-qty-up aria-label={`More ${a.label}`}>+</button>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  {/* ── 5 · date and location ────────────────────────────────────── */}
  <section class="cfg-step" data-step="details">
    <fieldset class="cfg-fieldset">
      <legend class="cfg-ask text-display-md measure-tight">When and where?</legend>
      <div class="cfg-fields">
        <p class="cfg-field">
          <label for="cfg-date">Your date</label>
          <input type="text" id="cfg-date" name="event_date" autocomplete="off"
                 data-cfg-date placeholder="Pick a date, or type not sure yet" />
          <span class="cfg-err" data-cfg-err="event_date" hidden></span>
        </p>
        <p class="cfg-field">
          <label for="cfg-location">Where is it happening?</label>
          <input type="text" id="cfg-location" name="location" autocomplete="off"
                 placeholder="A venue, a city, or not sure yet" />
          <span class="cfg-permit" data-cfg-permit hidden></span>
        </p>
      </div>
    </fieldset>
  </section>

  {/* ── 6 · their own question ───────────────────────────────────── */}
  <section class="cfg-step" data-step="ask">
    <fieldset class="cfg-fieldset">
      <legend class="cfg-ask text-display-md measure-tight">Anything you want to ask me?</legend>
      <p class="cfg-hint text-body-md">Optional. If something above was not clear, this is the place.</p>
      <p class="cfg-field">
        <label class="cfg-sr" for="cfg-message">Your question</label>
        <textarea id="cfg-message" name="message" rows="5"></textarea>
      </p>
    </fieldset>
  </section>

  {/* ── 7 · who you are ──────────────────────────────────────────── */}
  <section class="cfg-step" data-step="identity">
    <fieldset class="cfg-fieldset">
      <legend class="cfg-ask text-display-md measure-tight">Last thing. Who am I photographing?</legend>

      <div class="cfg-summary" data-cfg-summary hidden>
        <p class="cfg-summary__head" data-cfg-sum-pkg></p>
        <ul class="cfg-summary__list" data-cfg-sum-list></ul>
        <p class="cfg-summary__total" data-cfg-sum-total></p>
        <p class="cfg-summary__note" data-cfg-sum-note></p>
      </div>

      <div class="cfg-fields">
        <p class="cfg-field">
          <label for="cfg-name">Your name</label>
          <input type="text" id="cfg-name" name="name" autocomplete="name" />
          <span class="cfg-err" data-cfg-err="name" hidden></span>
        </p>
        <p class="cfg-field" data-cfg-partner>
          <label for="cfg-partner">Your partner's name</label>
          <input type="text" id="cfg-partner" name="partner_name" autocomplete="off" />
        </p>
        <p class="cfg-field">
          <label for="cfg-email">Email</label>
          <input type="email" id="cfg-email" name="email" autocomplete="email" inputmode="email" />
          <span class="cfg-err" data-cfg-err="email" hidden></span>
        </p>
        <p class="cfg-field">
          <label for="cfg-referral">Where did you find me?</label>
          {/* Values match ContactForm.astro exactly, so the Apps Script maps
              this straight into the sheet's Referral column. */}
          <span class="cfg-select">
            <select id="cfg-referral" name="referral" required aria-required="true">
              <option value="" selected>Select one</option>
              <option value="instagram">Instagram</option>
              <option value="google">Google search</option>
              <option value="reddit">Reddit</option>
              <option value="referral">A friend or family member</option>
              <option value="planner">Wedding planner or vendor</option>
              <option value="blog">Blog, article, or feature</option>
              <option value="other">Somewhere else</option>
            </select>
          </span>
          <span class="cfg-err" data-cfg-err="referral" hidden></span>
        </p>
      </div>
      <button type="submit" class="cfg-btn cfg-submit" data-cfg-submit>Send this to Kash</button>
      <p class="cfg-formerr" data-cfg-form-error hidden></p>
    </fieldset>
  </section>

  <section class="cfg-step cfg-done" data-step="done" hidden>
    <h2 class="cfg-ask text-display-md measure-tight">Got it.</h2>
    <p class="text-body-lg cfg-done__lead">
      Your package is with me. The quickest way forward is a short call, so pick a time that suits you.
    </p>
    <div class="cfg-done__actions"><BookingLink variant="dark" label="Pick a time" /></div>
    <p class="cfg-hint text-body-md">Or leave it with me and I will come back to you by email.</p>
  </section>

  </div>

  <aside class="cfg-total" data-cfg-total hidden aria-label="Your running total">
    <p class="cfg-total__pkg" data-cfg-total-pkg></p>
    <p class="cfg-total__sum" data-cfg-total-sum aria-live="polite"></p>
    <p class="cfg-total__note" data-cfg-total-note></p>
    <button type="button" class="cfg-btn cfg-next" data-cfg-next>Continue</button>
  </aside>
  </div>
</form>

<script type="application/json" id="cfg-data" set:html={JSON.stringify({ pkgIndex, addOnIndex, permitIndex, flow })} />

<style>
  /* The flow owns the viewport. The page never scrolls; the step body does.
     With scripts off every step is stacked inside that same scroll area, so
     the static price list still reads top to bottom. */
  .cfg--shell {
    position: fixed; inset: 0; z-index: 5;
    display: flex; flex-direction: column;
    background: var(--color-background);
    --cfg-gutter: clamp(1.125rem, 5vw, 4rem);
    padding-inline: var(--cfg-gutter);
  }
  .cfg-top { flex: 0 0 auto; padding-top: clamp(1.125rem, 3vw, 2.25rem); }
  .cfg-body {
    /* Vertical scroll only. Anything wider than the screen is clipped, never
       scrolled to, so a step can never slide sideways. */
    flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden;
    overscroll-behavior: contain; -webkit-overflow-scrolling: touch;
    /* Scrollbar hidden by request. It still scrolls; the bar is just not drawn. */
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .cfg-body::-webkit-scrollbar { width: 0; height: 0; display: none; }
  .cfg-flow { min-width: 0; }
  .cfg-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cfg-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .cfg-fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .cfg-step { padding-block: clamp(1.5rem, 4vw, 3rem); }
  .cfg-step[hidden] { display: none; }

  .cfg-ask { color: var(--color-on-surface); overflow-wrap: anywhere; min-width: 0; margin: 0 0 1rem; }
  .cfg-hint {
    color: var(--color-on-surface-variant); max-width: 48ch; margin: 0 0 var(--spacing-element);
  }

  /* ── wayfinding ─────────────────────────────────────────────────── */
  .cfg-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1.25rem; margin-bottom: 0.75rem;
  }
  .cfg-back {
    display: inline-flex; align-items: baseline; gap: 0.5rem;
    background: none; border: 0; padding: 0.25rem 0; cursor: pointer;
    font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-on-surface-variant);
    transition: color var(--duration-hover) var(--ease-gallery);
  }
  .cfg-back:hover { color: var(--color-on-surface); }
  .cfg-back:hover .cfg-back__arrow { transform: translateX(-3px); }
  .cfg-back__arrow { display: inline-block; transition: transform var(--duration-hover) var(--ease-gallery); }
  .cfg-back:focus-visible { outline: 2px solid var(--color-on-surface); outline-offset: 3px; }
  .cfg-count {
    font-family: var(--font-sans); font-size: 0.6875rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--color-on-surface-muted);
    font-variant-numeric: tabular-nums;
  }
  .cfg-rule { height: 1px; background: var(--color-surface-container); }
  .cfg-rule span {
    display: block; height: 1px; width: 0; background: var(--color-on-surface);
    transition: width var(--duration-slow) var(--ease-gallery);
  }

  /* ── 1 · category cards, real client work ──────────────────────── */
  .cfg-cards { display: grid; gap: 2.5rem 1.75rem; align-items: start; }
  /* Every frame is the same 4:5 aspect at equal column widths, so the labels
     land on the same line across all three columns without any offset. */
  .cfg-card {
    display: grid; grid-template-rows: auto auto; gap: 1.125rem;
    background: none; border: 0; padding: 0; margin: 0;
    text-align: left; cursor: pointer; color: var(--color-on-surface);
  }
  .cfg-card__frame {
    display: block; overflow: hidden; background: var(--color-surface-container);
    aspect-ratio: 4 / 5; max-width: 100%;
  }
  .cfg-card__img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--duration-deliberate) var(--ease-gallery),
                filter var(--duration-hover) var(--ease-gallery);
  }
  .cfg-card:hover .cfg-card__img { transform: scale(1.04); }
  .cfg-card__body { display: flex; flex-direction: column; gap: 0.3rem; }
  .cfg-card__label { transition: color var(--duration-hover) var(--ease-gallery); }
  .cfg-card__blurb {
    font-family: var(--font-sans); font-size: 0.875rem; line-height: 1.55;
    color: var(--color-on-surface-variant);
  }
  .cfg-card:focus-visible { outline: 2px solid var(--color-on-surface); outline-offset: 6px; }
  /* Selection is a small filled marker beside the label, matching the option
     rows. No border round the card, and no dimming the other photographs:
     both read as something having gone wrong rather than as a choice. */
  .cfg-card__label { display: flex; align-items: baseline; gap: 0.6rem; }
  /* display:none, not opacity:0. An invisible marker still occupies its box and
     the flex gap, which indented every label whether it was selected or not. */
  .cfg-card__label::before {
    content: ''; display: none; width: 9px; height: 9px; flex: 0 0 auto;
    background: var(--color-on-surface);
  }
  .cfg-card[aria-pressed='true'] .cfg-card__label::before { display: block; }

  /* ── 2 · options ───────────────────────────────────────────────── */
  .cfg-options { display: grid; gap: 0; }
  .cfg-opt {
    display: grid; grid-template-columns: auto minmax(0, 1fr);
    align-items: start; gap: 1.125rem;
    min-height: 76px; padding: 1.5rem 0.25rem;
    text-align: left; cursor: pointer; border: 0; background: none;
    border-bottom: 1px solid var(--color-surface-container);
    font-family: var(--font-sans); color: var(--color-on-surface);
