  /* ══ MOBILE (below 768px) ════════════════════════════════════════ */
  @media (max-width: 767px) {
    /* What has been chosen so far, as a bar fixed to the bottom of the screen.
       Fixed rather than sticky with negative margins: those made the bar one
       gutter wider than the scroll area, so every step could scroll sideways
       and cut off at the right edge. */
    .cfg-total {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
      display: grid; grid-template-columns: minmax(0, 1fr) auto;
      align-items: center; column-gap: 1rem;
      padding: 1rem var(--cfg-gutter) calc(1rem + env(safe-area-inset-bottom));
      background: var(--color-surface-dark); color: var(--color-on-dark);
    }
    /* room under the last card so the bar never covers a Choose button */
    .cfg-body:has(.cfg-total:not([hidden])) .cfg-flow { padding-bottom: 7rem; }
    .cfg-total__pkg, .cfg-total__sum { min-width: 0; overflow-wrap: anywhere; }
    .cfg-total__pkg { color: var(--color-on-dark-variant); }
    .cfg-total__sum { color: var(--color-on-dark); font-size: 1.375rem; }
    .cfg-total__note { display: none; }
    .cfg-next { grid-row: 1 / span 2; grid-column: 2; padding-inline: 1.5rem; }
    .cfg-addon__price { align-items: flex-start; text-align: left; grid-column: 2; }
    .cfg-addon__row { grid-template-columns: auto minmax(0, 1fr); row-gap: 0.65rem; }
  }

  /* ══ DESKTOP (768px and up) ══════════════════════════════════════ */
  @media (min-width: 768px) {
    .cfg-body {
      display: grid; grid-template-columns: minmax(0, 1fr) 20rem;
      column-gap: clamp(2rem, 5vw, 4rem);
      max-width: 78rem; margin-inline: auto; width: 100%;
    }
    /* No rail on this step, so the flow takes the whole width and the narrow
       steps centre themselves rather than leaving a gap to the right. */
    .cfg-body:has(.cfg-total[hidden]) { grid-template-columns: minmax(0, 1fr); max-width: 64rem; }
    /* The steps that are just fields read as a centred block, heading included. */
    .cfg-step[data-step='details'] .cfg-fieldset,
    .cfg-step[data-step='ask'] .cfg-fieldset,
    .cfg-step[data-step='identity'] .cfg-fieldset { max-width: 38rem; margin-inline: auto; }
    .cfg-step[data-step='done'] { max-width: 38rem; margin-inline: auto; }
    .cfg-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cfg-step[data-step='category'] .cfg-ask { max-width: 24ch; }
    .cfg-step[data-step='question'] .cfg-fieldset {
      display: grid; grid-template-columns: 5fr 7fr; column-gap: 3.5rem; align-items: start;
    }
    .cfg-step[data-step='question'] .cfg-ask, .cfg-step[data-step='question'] .cfg-hint { max-width: 22ch; }
    .cfg-packages { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
    .cfg-pkg { padding: 2.5rem 2rem; }
    .cfg-pkg--recommended { grid-column: 1 / -1; }
    .cfg-total {
      position: sticky; top: 0; align-self: start;
      padding: 1.75rem; background: var(--color-surface);
    }
    .cfg-total .cfg-next { width: 100%; margin-top: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cfg-card__img, .cfg-opt, .cfg-addon__row, .cfg-addon__mark, .cfg-opt__mark,
    .cfg-btn, .cfg-step-btn, .cfg-back, .cfg-back__arrow, .cfg-field input,
    .cfg-field textarea, .cfg-rule span, .cfg-total__sum { transition: none; }
    .cfg-card:hover .cfg-card__img { transform: none; }
    .cfg-opt:hover { padding-left: 0.25rem; }
    .cfg-total__sum.is-changing { opacity: 1; }
  }
</style>
