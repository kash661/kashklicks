  /* ── fields ────────────────────────────────────────────────────── */
  .cfg-fields { display: grid; gap: 1.75rem; max-width: 34rem; }
  .cfg-field { margin: 0; display: grid; gap: 0.5rem; }
  .cfg-field label {
    font-family: var(--font-sans); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-on-surface-muted);
  }
  .cfg-field input, .cfg-field textarea {
    width: 100%; min-height: 52px; padding: 0.75rem 0;
    border: 0; border-bottom: 1px solid color-mix(in srgb, var(--color-on-surface-variant) 40%, transparent);
    background: transparent; color: var(--color-on-surface);
    font-family: var(--font-sans); font-size: 1.0625rem;
    transition: border-color var(--duration-hover) var(--ease-gallery);
  }
  .cfg-field textarea { min-height: 8rem; resize: vertical; }
  .cfg-field input::placeholder, .cfg-field textarea::placeholder { color: var(--color-on-surface-muted); }
  .cfg-field input:hover, .cfg-field textarea:hover { border-bottom-color: var(--color-on-surface); }
  /* A focused field must show it, but an outline box is the wrong shape for a
     field that is otherwise a single rule. Note text inputs match
     :focus-visible on click as well as on keyboard, so a box appears on every
     tap. The indicator is the underline instead: it doubles in weight and goes
     to full ink, which is a large, high contrast change and satisfies the
     visible-focus requirement without drawing a rectangle. */
  .cfg-field input:focus, .cfg-field textarea:focus {
    outline: none;
    border-bottom-width: 2px;
    border-bottom-color: var(--color-on-surface);
    padding-bottom: calc(0.75rem - 1px);
  }
  .cfg-field[data-invalid] input, .cfg-field[data-invalid] textarea, .cfg-field[data-invalid] select,
  .cfg-field[data-invalid] input:focus, .cfg-field[data-invalid] textarea:focus,
  .cfg-field[data-invalid] select:focus {
    border-bottom-color: var(--color-error); border-bottom-width: 2px;
  }
  .cfg-select { position: relative; display: block; }
  .cfg-select::after {
    content: ''; position: absolute; right: 0.35rem; top: 50%;
    width: 7px; height: 7px; margin-top: -5px; pointer-events: none;
    border-right: 1px solid var(--color-on-surface-variant);
    border-bottom: 1px solid var(--color-on-surface-variant);
    transform: rotate(45deg);
  }
  .cfg-field select {
    appearance: none; width: 100%; min-height: 52px;
    padding: 0.75rem 1.75rem 0.75rem 0;
    border: 0; border-bottom: 1px solid color-mix(in srgb, var(--color-on-surface-variant) 40%, transparent);
    background: transparent; color: var(--color-on-surface);
    font-family: var(--font-sans); font-size: 1.0625rem; cursor: pointer;
    transition: border-color var(--duration-hover) var(--ease-gallery);
  }
  .cfg-field select:hover { border-bottom-color: var(--color-on-surface); }
  .cfg-field select:focus {
    outline: none; border-bottom-width: 2px;
    border-bottom-color: var(--color-on-surface);
    padding-bottom: calc(0.75rem - 1px);
  }
  .cfg-err, .cfg-formerr { font-family: var(--font-sans); font-size: 0.8125rem; color: var(--color-error); }
  .cfg-formerr { margin-top: 1rem; }
  .cfg-permit {
    font-family: var(--font-sans); font-size: 0.8125rem; line-height: 1.6;
    color: var(--color-on-surface-variant); max-width: 50ch;
  }
  .cfg-submit { margin-top: var(--spacing-element); }
  .cfg-summary {
    background: var(--color-surface); padding: 1.5rem;
    margin-bottom: var(--spacing-element); max-width: 34rem;
  }
  .cfg-summary[hidden] { display: none; }
  .cfg-summary__head {
    font-family: var(--font-serif); font-size: 1.25rem; margin: 0 0 1rem;
    color: var(--color-on-surface);
  }
  .cfg-summary__list { list-style: none; padding: 0; margin: 0; }
  /* :global because these rows are built in JS and so never get the
     data-astro-cid scope attribute that scoped selectors match on. */
  .cfg-summary__list :global(li) {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem 1rem;
    font-family: var(--font-sans); font-size: 0.9375rem; line-height: 1.5;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--color-surface-container);
  }
  .cfg-summary__list :global(li span:last-child) {
    font-variant-numeric: tabular-nums; color: var(--color-on-surface-variant);
    white-space: nowrap; text-align: right;
  }
  /* An answer row is a question and its answer, and questions are long, so
     they stack rather than fighting for one line. */
  .cfg-summary__list :global(li[data-answer]) { grid-template-columns: minmax(0, 1fr); }
  .cfg-summary__list :global(li[data-answer] span:first-child) {
    font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-on-surface-muted);
  }
  .cfg-summary__list :global(li[data-answer] span:last-child) {
    text-align: left; white-space: normal; color: var(--color-on-surface);
  }
  .cfg-summary__total {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    font-family: var(--font-sans); font-weight: 500; font-size: 1.25rem;
    font-variant-numeric: tabular-nums; margin: 1rem 0 0;
  }
  .cfg-summary__total :global(span) { white-space: nowrap; }
  .cfg-summary__note {
    font-family: var(--font-sans); font-size: 0.75rem; line-height: 1.6;
    color: var(--color-on-surface-muted); margin: 0.5rem 0 0;
  }
  .cfg-done__lead { max-width: 46ch; margin: 0 0 var(--spacing-element); }
